---
import Layout from '../../layouts/Layout.astro';
import { getDb, products, productImages, siteSettings } from '../../db';
import { eq } from 'drizzle-orm';
import type { Env } from '../../types';

const env = Astro.locals.runtime?.env as Env;
const id = Astro.params.id;

if (!id || !env?.DB) {
  return Astro.redirect('/catalogo');
}

const db = getDb(env.DB);
const productList = await db.select().from(products).where(eq(products.id, id));

if (productList.length === 0) {
  return Astro.redirect('/catalogo');
}

const product = productList[0];
const images = await db.select().from(productImages).where(eq(productImages.productId, id));
const sortedImages = images.sort((a, b) => a.orderIndex - b.orderIndex).map((i) => i.imageUrl);
const mainImage =
  sortedImages[0] || 'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=800&q=80';

let opticalName = 'Óptica Visión Moderna';
let whatsappNumber = '+56912345678';

const settings = await db.select().from(siteSettings);
settings.forEach((s) => {
  if (s.key === 'optical_name') opticalName = s.value;
  if (s.key === 'whatsapp_number') whatsappNumber = s.value;
});

const cleanWhatsapp = whatsappNumber.replace(/[^0-9]/g, '');
const currentUrl = Astro.url.href;

const whatsappMessage = encodeURIComponent(
  `Hola ${opticalName}, me quiero probar el modelo "${product.name}" (${product.brand}${
    product.modelCode ? ` - Ref: ${product.modelCode}` : ''
  }) que vi en la web: ${currentUrl}. ¿Lo tienen disponible en tienda?`
);

const whatsappLink = `https://wa.me/${cleanWhatsapp}?text=${whatsappMessage}`;
---

<Layout
  title={`${product.name} (${product.brand}) | ${opticalName}`}
  description={`Conoce el modelo ${product.name} de ${product.brand}. Armazón ${product.frameMaterial || ''} en color ${product.color}. Pruébatelo en nuestra óptica.`}
>
  <!-- Breadcrumb -->
  <nav aria-label="Ruta de navegación" class="bg-zinc-50 border-b border-zinc-200/80">
    <ol class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 text-xs font-semibold text-zinc-500 flex items-center gap-2 overflow-x-auto">
      <li><a href="/" class="hover:text-blue-600 transition-colors">Inicio</a></li>
      <li aria-hidden="true" class="text-zinc-300">/</li>
      <li><a href="/catalogo" class="hover:text-blue-600 transition-colors">Catálogo</a></li>
      <li aria-hidden="true" class="text-zinc-300">/</li>
      <li>
        <a href={`/catalogo?category=${product.category}`} class="hover:text-blue-600 capitalize transition-colors">
          {product.category}
        </a>
      </li>
      <li aria-hidden="true" class="text-zinc-300">/</li>
      <li aria-current="page" class="text-zinc-950 font-bold truncate">{product.name}</li>
    </ol>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      <!-- Galería de Fotos -->
      <div class="lg:col-span-7 space-y-4">
        <div class="relative bg-zinc-100 rounded-3xl overflow-hidden border border-zinc-200 aspect-[4/3] flex items-center justify-center p-6">
          <img
            id="main-photo"
            src={mainImage}
            alt={`${product.name} - ${product.brand}`}
            width="800"
            height="600"
            class="w-full h-full object-contain rounded-2xl transition-opacity duration-200"
          />
        </div>

        <!-- Miniaturas -->
        {sortedImages.length > 1 && (
          <div class="grid grid-cols-4 sm:grid-cols-6 gap-3" role="group" aria-label="Vistas del lente">
            {sortedImages.map((imgUrl, idx) => (
              <button
                type="button"
                aria-label={`Ver foto ${idx + 1} de ${product.name}`}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class={`thumb-btn rounded-2xl overflow-hidden border-2 aspect-square bg-zinc-100 p-1 transition cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${
                  idx === 0 ? 'border-blue-600 ring-2 ring-blue-600/20' : 'border-zinc-200 hover:border-zinc-400'
                }`}
                data-url={imgUrl}
              >
                <img
                  src={imgUrl}
                  alt=""
                  width="120"
                  height="120"
                  class="w-full h-full object-cover rounded-xl"
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        )}

        <!-- Beneficios Estilo Ben & Frank / OPV -->
        <div class="p-6 rounded-3xl bg-zinc-50 border border-zinc-200 grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div class="flex items-start gap-3">
            <div class="size-10 rounded-2xl bg-blue-600 text-white flex items-center justify-center shrink-0">
              <svg class="size-5" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-extrabold text-zinc-950 uppercase">Pruébatelo gratis</p>
              <p class="text-xs text-zinc-500 mt-0.5">Ven a la óptica sin compromiso</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="size-10 rounded-2xl bg-yellow-400 text-zinc-950 flex items-center justify-center shrink-0">
              <svg class="size-5" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-extrabold text-zinc-950 uppercase">Ajuste a tu medida</p>
              <p class="text-xs text-zinc-500 mt-0.5">Lo dejamos cómodo en el acto</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="size-10 rounded-2xl bg-emerald-500 text-white flex items-center justify-center shrink-0">
              <svg class="size-5" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-extrabold text-zinc-950 uppercase">Tu receta lista</p>
              <p class="text-xs text-zinc-500 mt-0.5">Cristales ópticos y filtro azul</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Ficha Derecha -->
      <div class="lg:col-span-5">
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-zinc-200 shadow-sm space-y-6">
          <div>
            <span class="text-xs font-extrabold text-blue-600 uppercase tracking-wider block">
              {product.brand}
            </span>
            <h1 class="font-display text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight mt-1">
              {product.name}
            </h1>
            {product.modelCode && (
              <p class="text-xs font-semibold text-zinc-400 mt-1">
                Código: <span class="font-mono font-bold text-zinc-700 tabular-nums">{product.modelCode}</span>
              </p>
            )}
          </div>

          <!-- Precio -->
          <div class="p-5 rounded-2xl bg-zinc-50 border border-zinc-200/80">
            <div>
              <span class="text-[11px] font-extrabold text-zinc-400 uppercase tracking-wider block">
                Valor Marco
              </span>
              {product.priceOnRequest ? (
                <span class="font-display text-xl font-extrabold text-zinc-900 mt-0.5 block">Consultar en tienda</span>
              ) : (
                <span class="font-display text-4xl font-extrabold text-zinc-950 tabular-nums mt-0.5 block">
                  ${product.price ? product.price.toLocaleString('es-CL') : '0'}
                </span>
              )}
            </div>
          </div>

          <!-- CTA WhatsApp -->
          <div class="space-y-2.5">
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-4 px-6 min-h-12 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-sm uppercase tracking-wider shadow-lg shadow-emerald-500/25 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2.5 text-center"
            >
              <svg class="size-5 fill-current shrink-0" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
              </svg>
              <span>¡Me lo quiero probar! (WhatsApp)</span>
            </a>
            <p class="text-[11px] font-medium text-center text-zinc-400">
              Te responderemos al instante con disponibilidad y cotización de tus cristales.
            </p>
          </div>

          <!-- Ficha Técnica -->
          <div class="pt-6 border-t border-zinc-100 space-y-3">
            <h2 class="text-xs font-extrabold text-zinc-950 uppercase tracking-wider">
              Ficha del Armazón
            </h2>
            <dl class="divide-y divide-zinc-100 text-xs">
              <div class="py-3 flex justify-between gap-4">
                <dt class="text-zinc-500 font-medium">Categoría</dt>
                <dd class="font-bold text-zinc-950 capitalize">{product.category}</dd>
              </div>
              <div class="py-3 flex justify-between gap-4">
                <dt class="text-zinc-500 font-medium">Público</dt>
                <dd class="font-bold text-zinc-950 capitalize">{product.gender}</dd>
              </div>
              <div class="py-3 flex justify-between gap-4">
                <dt class="text-zinc-500 font-medium">Color</dt>
                <dd class="font-bold text-zinc-950 text-right">{product.color}</dd>
              </div>
              {product.frameMaterial && (
                <div class="py-3 flex justify-between gap-4">
                  <dt class="text-zinc-500 font-medium">Material</dt>
                  <dd class="font-bold text-zinc-950 capitalize">{product.frameMaterial}</dd>
                </div>
              )}
              {product.frameShape && (
                <div class="py-3 flex justify-between gap-4">
                  <dt class="text-zinc-500 font-medium">Forma</dt>
                  <dd class="font-bold text-zinc-950 capitalize">{product.frameShape}</dd>
                </div>
              )}
              {product.dimensions && (
                <div class="py-3 flex justify-between gap-4">
                  <dt class="text-zinc-500 font-medium">Medidas (Calibre-Puente-Varilla)</dt>
                  <dd class="font-mono font-bold text-zinc-950 tabular-nums">{product.dimensions}</dd>
                </div>
              )}
            </dl>
          </div>

          {product.description && (
            <div class="pt-5 border-t border-zinc-100">
              <h3 class="text-xs font-extrabold text-zinc-950 uppercase tracking-wider mb-2">
                Sobre este modelo
              </h3>
              <p class="text-xs text-zinc-600 leading-relaxed whitespace-pre-line">{product.description}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <script>
    const mainPhoto = document.getElementById('main-photo') as HTMLImageElement;
    const thumbButtons = document.querySelectorAll('.thumb-btn') as NodeListOf<HTMLButtonElement>;

    thumbButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const newUrl = btn.getAttribute('data-url');
        if (newUrl && mainPhoto) {
          mainPhoto.src = newUrl;
          thumbButtons.forEach((b) => {
            b.setAttribute('aria-pressed', 'false');
            b.classList.remove('border-blue-600', 'ring-2', 'ring-blue-600/20');
            b.classList.add('border-zinc-200');
          });
          btn.setAttribute('aria-pressed', 'true');
          btn.classList.remove('border-zinc-200');
          btn.classList.add('border-blue-600', 'ring-2', 'ring-blue-600/20');
        }
      });
    });
  </script>
</Layout>
