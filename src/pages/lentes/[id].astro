---
import Layout from '../../layouts/Layout.astro';
import { getDb, products, productImages, siteSettings } from '../../db';
import { eq } from 'drizzle-orm';
import type { Env } from '../../types';

const env = Astro.locals.runtime?.env as Env;
const id = Astro.params.id;

if (!id || !env?.DB) {
  return Astro.redirect('/catalogo');
}

const db = getDb(env.DB);
const productList = await db.select().from(products).where(eq(products.id, id));

if (productList.length === 0) {
  return Astro.redirect('/catalogo');
}

const product = productList[0];
const images = await db.select().from(productImages).where(eq(productImages.productId, id));
const sortedImages = images.sort((a, b) => a.orderIndex - b.orderIndex).map((i) => i.imageUrl);
const mainImage = sortedImages[0] || 'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=800&q=80';

// Configuración de la óptica
let opticalName = 'Óptica Visión Moderna';
let whatsappNumber = '+56912345678';

const settings = await db.select().from(siteSettings);
settings.forEach((s) => {
  if (s.key === 'optical_name') opticalName = s.value;
  if (s.key === 'whatsapp_number') whatsappNumber = s.value;
});

const cleanWhatsapp = whatsappNumber.replace(/[^0-9]/g, '');
const currentUrl = Astro.url.href;

// Mensaje prellenado automático para WhatsApp
const whatsappMessage = encodeURIComponent(
  `Hola ${opticalName}, me interesa probarme el armazón "${product.name}" (${product.brand}${
    product.modelCode ? ` - Ref: ${product.modelCode}` : ''
  }) que vi en su catálogo: ${currentUrl}. ¿Tienen stock disponible en su local?`
);

const whatsappLink = `https://wa.me/${cleanWhatsapp}?text=${whatsappMessage}`;
---

<Layout
  title={`${product.name} (${product.brand}) | Ficha Técnica | ${opticalName}`}
  description={`Ficha técnica de ${product.name} de ${product.brand}. Armazón ${product.frameMaterial || ''} en color ${product.color}. Consulta por WhatsApp.`}
>
  <div class="bg-slate-100/60 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 text-xs text-slate-500 flex items-center gap-2 overflow-x-auto">
      <a href="/" class="hover:text-cyan-600 transition">Inicio</a>
      <span>/</span>
      <a href="/catalogo" class="hover:text-cyan-600 transition">Catálogo</a>
      <span>/</span>
      <a href={`/catalogo?category=${product.category}`} class="hover:text-cyan-600 capitalize transition">
        {product.category}
      </a>
      <span>/</span>
      <span class="text-slate-800 font-semibold truncate">{product.name}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Galería de Fotos (Columna Izquierda) -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Foto Principal -->
        <div class="relative bg-white rounded-3xl overflow-hidden border border-slate-200/80 aspect-[4/3] flex items-center justify-center p-4 shadow-xs">
          <img
            id="main-photo"
            src={mainImage}
            alt={product.name}
            class="w-full h-full object-contain rounded-2xl transition duration-300"
          />

          {product.isWeeklyFeature && (
            <span class="absolute top-4 left-4 bg-amber-500 text-white text-xs font-extrabold uppercase px-3 py-1 rounded-full shadow-xs flex items-center gap-1">
              <span>✨ Novedad de la Semana</span>
            </span>
          )}

          <span class={`absolute top-4 right-4 text-xs font-bold uppercase px-3 py-1 rounded-full ${
            product.status === 'in_stock'
              ? 'bg-emerald-100 text-emerald-800'
              : 'bg-rose-100 text-rose-800'
          }`}>
            {product.status === 'in_stock' ? 'En Stock Inmediato' : 'Agotado Temporal'}
          </span>
        </div>

        <!-- Miniaturas si hay múltiples fotos -->
        {sortedImages.length > 1 && (
          <div class="grid grid-cols-4 sm:grid-cols-6 gap-3">
            {sortedImages.map((imgUrl, idx) => (
              <button
                class={`thumb-btn rounded-2xl overflow-hidden border-2 aspect-square bg-white p-1 transition ${
                  idx === 0 ? 'border-cyan-600 ring-2 ring-cyan-600/20' : 'border-slate-200 hover:border-cyan-400'
                }`}
                data-url={imgUrl}
              >
                <img src={imgUrl} class="w-full h-full object-cover rounded-xl" loading="lazy" />
              </button>
            ))}
          </div>
        )}

        <!-- Banner de Garantía y Prueba -->
        <div class="p-5 rounded-2xl bg-cyan-50/60 border border-cyan-100 text-cyan-900 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
          <div>
            <span class="text-xl block mb-1">🔍</span>
            <p class="text-xs font-bold">Prueba sin Compromiso</p>
            <p class="text-[11px] text-cyan-700 mt-0.5">Visítanos y pruébatelo en persona</p>
          </div>
          <div>
            <span class="text-xl block mb-1">🛠️</span>
            <p class="text-xs font-bold">Ajuste Gratuito</p>
            <p class="text-[11px] text-cyan-700 mt-0.5">Calce perfecto a tu rostro</p>
          </div>
          <div>
            <span class="text-xl block mb-1">✨</span>
            <p class="text-xs font-bold">Cristales a Medida</p>
            <p class="text-[11px] text-cyan-700 mt-0.5">Compatibles con tu receta</p>
          </div>
        </div>
      </div>

      <!-- Información y Ficha Técnica (Columna Derecha) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xs space-y-6">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest block">{product.brand}</span>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">{product.name}</h1>
            {product.modelCode && (
              <p class="text-xs font-medium text-slate-500 mt-1">
                Referencia: <span class="font-mono font-bold text-slate-700">{product.modelCode}</span>
              </p>
            )}
          </div>

          <!-- Precio -->
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Precio de Referencia</span>
              {product.priceOnRequest ? (
                <span class="text-base font-bold text-slate-700 italic">Consultar en tienda</span>
              ) : (
                <span class="text-3xl font-black text-slate-900">
                  ${product.price ? product.price.toLocaleString('es-CL') : '0'}
                </span>
              )}
            </div>
            <span class="text-xs text-slate-500 text-right">Armazón oficial</span>
          </div>

          <!-- Botón Destacado de WhatsApp -->
          <div class="space-y-2.5">
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-4 px-6 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold text-base shadow-lg shadow-emerald-600/25 transition flex items-center justify-center gap-3 group text-center"
            >
              <svg class="w-6 h-6 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
              </svg>
              <span>Consultar por WhatsApp</span>
            </a>
            <p class="text-[11px] text-center text-slate-400">
              💬 Se enviará automáticamente el modelo y la ficha para que te respondamos de inmediato.
            </p>
          </div>

          <!-- Ficha Técnica de Óptica -->
          <div class="pt-6 border-t border-slate-100 space-y-3">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Ficha Técnica del Armazón</h3>
            <div class="divide-y divide-slate-100 text-xs">
              <div class="py-2.5 flex justify-between">
                <span class="text-slate-500 font-medium">Categoría</span>
                <span class="font-bold text-slate-900 capitalize">{product.category}</span>
              </div>
              <div class="py-2.5 flex justify-between">
                <span class="text-slate-500 font-medium">Público / Género</span>
                <span class="font-bold text-slate-900 capitalize">{product.gender}</span>
              </div>
              <div class="py-2.5 flex justify-between">
                <span class="text-slate-500 font-medium">Color & Acabado</span>
                <span class="font-bold text-slate-900">{product.color}</span>
              </div>
              {product.frameMaterial && (
                <div class="py-2.5 flex justify-between">
                  <span class="text-slate-500 font-medium">Material</span>
                  <span class="font-bold text-slate-900 capitalize">{product.frameMaterial}</span>
                </div>
              )}
              {product.frameShape && (
                <div class="py-2.5 flex justify-between">
                  <span class="text-slate-500 font-medium">Forma</span>
                  <span class="font-bold text-slate-900 capitalize">{product.frameShape}</span>
                </div>
              )}
              {product.dimensions && (
                <div class="py-2.5 flex justify-between">
                  <span class="text-slate-500 font-medium">Calibre (Medidas)</span>
                  <span class="font-mono font-bold text-slate-900">{product.dimensions}</span>
                </div>
              )}
            </div>
          </div>

          {product.description && (
            <div class="pt-4 border-t border-slate-100">
              <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Detalles y Especificaciones</h4>
              <p class="text-xs text-slate-600 leading-relaxed whitespace-pre-line">{product.description}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <script>
    const mainPhoto = document.getElementById('main-photo') as HTMLImageElement;
    const thumbButtons = document.querySelectorAll('.thumb-btn') as NodeListOf<HTMLButtonElement>;

    thumbButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const newUrl = btn.getAttribute('data-url');
        if (newUrl && mainPhoto) {
          mainPhoto.src = newUrl;
          thumbButtons.forEach((b) => {
            b.classList.remove('border-cyan-600', 'ring-2', 'ring-cyan-600/20');
            b.classList.add('border-slate-200');
          });
          btn.classList.remove('border-slate-200');
          btn.classList.add('border-cyan-600', 'ring-2', 'ring-cyan-600/20');
        }
      });
    });
  </script>
</Layout>
