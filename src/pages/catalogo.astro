---
import Layout from '../layouts/Layout.astro';
import { getDb, products, productImages, siteSettings } from '../db';
import { desc } from 'drizzle-orm';
import type { Env } from '../types';

const env = Astro.locals.runtime?.env as Env;
let allProducts: any[] = [];
let opticalName = 'Óptica Visión Moderna';
let whatsappNumber = '+56912345678';

if (env?.DB) {
  try {
    const db = getDb(env.DB);
    const settings = await db.select().from(siteSettings);
    settings.forEach((s) => {
      if (s.key === 'optical_name') opticalName = s.value;
      if (s.key === 'whatsapp_number') whatsappNumber = s.value;
    });

    const prods = await db.select().from(products).orderBy(desc(products.createdAt));
    const imgs = await db.select().from(productImages);

    allProducts = prods.map((p) => {
      const prodImgs = imgs.filter((i) => i.productId === p.id).sort((a, b) => a.orderIndex - b.orderIndex);
      return {
        ...p,
        primaryImage:
          prodImgs.find((i) => i.isPrimary)?.imageUrl ||
          prodImgs[0]?.imageUrl ||
          'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=600&q=80',
      };
    });
  } catch (e) {
    console.error('Error fetching catalog:', e);
  }
}

const cleanWhatsapp = whatsappNumber.replace(/[^0-9]/g, '');

const initialCategory = Astro.url.searchParams.get('category') || 'todos';
const initialWeekly = Astro.url.searchParams.get('weekly') === 'true';

const categories = [
  { id: 'todos', label: 'Todos' },
  { id: 'opticos', label: 'Ópticos' },
  { id: 'sol', label: 'De Sol' },
  { id: 'filtro-azul', label: 'Filtro Azul' },
  { id: 'infantil', label: 'Infantil' },
];

const genders = [
  { id: 'todos', label: 'Todos' },
  { id: 'unisex', label: 'Unisex' },
  { id: 'mujer', label: 'Mujer' },
  { id: 'hombre', label: 'Hombre' },
];
---

<Layout title={`Catálogo de Lentes | ${opticalName}`}>
  <!-- Cabecera Moderna Estilo Ben & Frank / OPV -->
  <section class="bg-zinc-50 border-b border-zinc-200/80 py-10 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl sm:text-5xl font-extrabold text-zinc-950 tracking-tight">
          Encuentra tus próximos lentes
        </h1>
        <p class="text-zinc-600 text-sm sm:text-base font-medium mt-1.5 max-w-xl">
          Filtra por categoría, busca tu estilo y escríbenos directo por WhatsApp para reservar o probártelos en tienda.
        </p>
      </div>

      <div
        class="px-4 py-2 rounded-full bg-white border border-zinc-200 text-xs font-extrabold text-zinc-800 tabular-nums self-start md:self-auto"
        aria-live="polite"
        id="results-counter"
      >
        {allProducts.length} modelos disponibles
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Barra de Filtros Moderna y Ágil -->
    <div class="bg-white p-5 sm:p-6 rounded-3xl border border-zinc-200 shadow-xs mb-8 space-y-5">
      <div class="flex flex-col md:flex-row gap-3.5 items-stretch md:items-center justify-between">
        <!-- Buscador -->
        <div class="w-full md:w-96 relative">
          <label for="catalog-search" class="sr-only">Buscar por marca, modelo o color</label>
          <input
            type="search"
            id="catalog-search"
            placeholder="Buscar marca, modelo o color..."
            class="w-full pl-11 pr-4 py-2.5 min-h-11 rounded-2xl border border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-950 placeholder:text-zinc-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
          />
          <svg
            class="size-4 text-zinc-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </div>

        <!-- Toggle Novedades Semanales -->
        <label class="inline-flex items-center justify-center gap-2.5 px-4 py-2.5 min-h-11 rounded-2xl bg-yellow-300/70 hover:bg-yellow-300 border border-yellow-400 cursor-pointer transition-colors select-none">
          <input
            type="checkbox"
            id="filter-weekly"
            class="size-4 rounded border-zinc-900 text-zinc-950 focus:ring-blue-600 cursor-pointer"
            checked={initialWeekly}
          />
          <svg class="size-4 text-zinc-950 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
          <span class="text-xs font-extrabold text-zinc-950 uppercase tracking-wider">
            Solo Drops de la Semana
          </span>
        </label>
      </div>

      <!-- Chips de Categoría y Público -->
      <div class="pt-4 border-t border-zinc-100 flex flex-col lg:flex-row gap-4 lg:items-center justify-between">
        <div class="flex flex-wrap gap-2 items-center" role="group" aria-label="Filtrar por categoría">
          <span class="text-xs font-extrabold text-zinc-400 uppercase tracking-wider mr-1">Categoría:</span>
          {categories.map((cat) => {
            const isActive = initialCategory === cat.id;
            return (
              <button
                type="button"
                aria-pressed={isActive ? 'true' : 'false'}
                class={`filter-cat-btn px-4 py-2 min-h-10 rounded-full text-xs font-extrabold uppercase tracking-wider transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${
                  isActive
                    ? 'bg-blue-600 text-white shadow-sm'
                    : 'bg-zinc-100 text-zinc-700 hover:bg-zinc-200'
                }`}
                data-cat={cat.id}
              >
                {cat.label}
              </button>
            );
          })}
        </div>

        <div class="flex flex-wrap gap-2 items-center" role="group" aria-label="Filtrar por público">
          <span class="text-xs font-extrabold text-zinc-400 uppercase tracking-wider mr-1">Para:</span>
          {genders.map((gen) => {
            const isActive = gen.id === 'todos';
            return (
              <button
                type="button"
                aria-pressed={isActive ? 'true' : 'false'}
                class={`filter-gen-btn px-4 py-2 min-h-10 rounded-full text-xs font-extrabold uppercase tracking-wider transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${
                  isActive
                    ? 'bg-zinc-950 text-white shadow-sm'
                    : 'bg-zinc-100 text-zinc-700 hover:bg-zinc-200'
                }`}
                data-gen={gen.id}
              >
                {gen.label}
              </button>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Grid de Lentes -->
    <div id="catalog-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {allProducts.map((p) => {
        const whatsappMsg = encodeURIComponent(
          `Hola ${opticalName}, quiero consultar disponibilidad del modelo ${p.name} (${p.brand}) que vi en el catálogo web.`
        );
        const consultLink = `https://wa.me/${cleanWhatsapp}?text=${whatsappMsg}`;

        return (
          <article
            class="product-card group bg-white rounded-3xl overflow-hidden border border-zinc-200 hover:border-zinc-950 hover:-translate-y-1 hover:shadow-xl transition-all duration-200 flex flex-col"
            data-name={p.name.toLowerCase()}
            data-brand={p.brand.toLowerCase()}
            data-model={p.modelCode ? p.modelCode.toLowerCase() : ''}
            data-color={p.color.toLowerCase()}
            data-cat={p.category.toLowerCase()}
            data-gender={p.gender.toLowerCase()}
            data-weekly={p.isWeeklyFeature ? 'true' : 'false'}
          >
            <!-- Foto -->
            <a
              href={`/lentes/${p.id}`}
              class="relative block overflow-hidden bg-zinc-100 aspect-[4/3] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              <img
                src={p.primaryImage}
                alt={`${p.name} - ${p.brand}`}
                width="600"
                height="450"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>

            <!-- Contenido -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <p class="text-[11px] font-extrabold text-blue-600 uppercase tracking-wider">{p.brand}</p>
                <a href={`/lentes/${p.id}`} class="block mt-0.5">
                  <h2 class="font-display text-lg font-extrabold text-zinc-950 group-hover:text-blue-600 transition-colors leading-snug line-clamp-1">
                    {p.name}
                  </h2>
                </a>
                <p class="text-xs font-medium text-zinc-500 mt-1 line-clamp-1 tabular-nums">
                  {p.color} {p.dimensions ? `· ${p.dimensions}` : ''}
                </p>
              </div>

              <div class="pt-4 mt-4 border-t border-zinc-100 flex items-center justify-between gap-2">
                <div>
                  {p.priceOnRequest ? (
                    <span class="text-xs font-bold text-zinc-500">Consultar valor</span>
                  ) : (
                    <div>
                      <span class="text-[10px] font-bold text-zinc-400 uppercase block">Precio</span>
                      <span class="font-display text-xl font-extrabold text-zinc-950 tabular-nums">
                        ${p.price?.toLocaleString('es-CL')}
                      </span>
                    </div>
                  )}
                </div>

                <div class="flex items-center gap-1.5">
                  <a
                    href={`/lentes/${p.id}`}
                    class="px-3.5 py-2 min-h-10 rounded-full bg-zinc-100 hover:bg-zinc-950 hover:text-white text-zinc-900 text-xs font-extrabold uppercase tracking-wider transition-colors inline-flex items-center"
                  >
                    Ver
                  </a>
                  <a
                    href={consultLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Consultar por ${p.name} en WhatsApp`}
                    class="size-10 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white transition-colors inline-flex items-center justify-center shrink-0"
                    title="Consultar por WhatsApp"
                  >
                    <svg class="size-4 fill-current" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Sin resultados -->
    <div id="no-results" class="hidden text-center py-16 px-4 bg-zinc-50 rounded-3xl border border-zinc-200">
      <div class="size-12 rounded-2xl bg-white border border-zinc-200 text-zinc-900 flex items-center justify-center mx-auto mb-4">
        <svg class="size-6" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
      </div>
      <h3 class="font-display text-xl font-extrabold text-zinc-950">No encontramos lentes con esos filtros</h3>
      <p class="text-sm text-zinc-500 mt-1">Prueba cambiando de categoría o limpiando la búsqueda.</p>
      <button
        type="button"
        id="btn-reset-filters"
        class="mt-5 px-6 py-3 min-h-11 bg-blue-600 hover:bg-blue-700 text-white text-xs font-extrabold uppercase tracking-wider rounded-full transition-colors cursor-pointer"
      >
        Ver todos los lentes
      </button>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
    const weeklyCheck = document.getElementById('filter-weekly') as HTMLInputElement;
    const catButtons = document.querySelectorAll('.filter-cat-btn') as NodeListOf<HTMLButtonElement>;
    const genButtons = document.querySelectorAll('.filter-gen-btn') as NodeListOf<HTMLButtonElement>;
    const cards = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('no-results') as HTMLDivElement;
    const btnReset = document.getElementById('btn-reset-filters') as HTMLButtonElement;
    const resultsCounter = document.getElementById('results-counter') as HTMLElement;

    let selectedCat = 'todos';
    let selectedGen = 'todos';

    catButtons.forEach((b) => {
      if (b.getAttribute('aria-pressed') === 'true') {
        selectedCat = b.getAttribute('data-cat') || 'todos';
      }
    });

    function setActiveCatPill(buttons: NodeListOf<HTMLButtonElement>, activeBtn: HTMLButtonElement) {
      buttons.forEach((b) => {
        b.setAttribute('aria-pressed', 'false');
        b.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
        b.classList.add('bg-zinc-100', 'text-zinc-700');
      });
      activeBtn.setAttribute('aria-pressed', 'true');
      activeBtn.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
      activeBtn.classList.remove('bg-zinc-100', 'text-zinc-700');
    }

    function setActiveGenPill(buttons: NodeListOf<HTMLButtonElement>, activeBtn: HTMLButtonElement) {
      buttons.forEach((b) => {
        b.setAttribute('aria-pressed', 'false');
        b.classList.remove('bg-zinc-950', 'text-white', 'shadow-sm');
        b.classList.add('bg-zinc-100', 'text-zinc-700');
      });
      activeBtn.setAttribute('aria-pressed', 'true');
      activeBtn.classList.add('bg-zinc-950', 'text-white', 'shadow-sm');
      activeBtn.classList.remove('bg-zinc-100', 'text-zinc-700');
    }

    function applyFilters() {
      const q = searchInput.value.toLowerCase().trim();
      const onlyWeekly = weeklyCheck.checked;
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const brand = card.getAttribute('data-brand') || '';
        const model = card.getAttribute('data-model') || '';
        const color = card.getAttribute('data-color') || '';
        const cat = card.getAttribute('data-cat') || '';
        const gen = card.getAttribute('data-gender') || '';
        const isWeekly = card.getAttribute('data-weekly') === 'true';

        const matchesQuery = !q || name.includes(q) || brand.includes(q) || model.includes(q) || color.includes(q);
        const matchesCat = selectedCat === 'todos' || cat === selectedCat;
        const matchesGen = selectedGen === 'todos' || gen === selectedGen;
        const matchesWeekly = !onlyWeekly || isWeekly;

        if (matchesQuery && matchesCat && matchesGen && matchesWeekly) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      noResults.classList.toggle('hidden', visibleCount > 0);
      if (resultsCounter) {
        resultsCounter.textContent =
          visibleCount === 1 ? '1 modelo disponible' : `${visibleCount} modelos disponibles`;
      }
    }

    searchInput?.addEventListener('input', applyFilters);
    weeklyCheck?.addEventListener('change', applyFilters);

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActiveCatPill(catButtons, btn);
        selectedCat = btn.getAttribute('data-cat') || 'todos';
        applyFilters();
      });
    });

    genButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActiveGenPill(genButtons, btn);
        selectedGen = btn.getAttribute('data-gen') || 'todos';
        applyFilters();
      });
    });

    btnReset?.addEventListener('click', () => {
      searchInput.value = '';
      weeklyCheck.checked = false;
      if (catButtons[0]) catButtons[0].click();
      if (genButtons[0]) genButtons[0].click();
    });

    applyFilters();
  </script>
</Layout>
