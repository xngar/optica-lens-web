---
import Layout from '../layouts/Layout.astro';
import { getDb, products, productImages, siteSettings } from '../db';
import { desc } from 'drizzle-orm';
import type { Env } from '../types';

const env = Astro.locals.runtime?.env as Env;
let allProducts: any[] = [];
let opticalName = 'Óptica Visión Moderna';
let whatsappNumber = '+56912345678';

if (env?.DB) {
  try {
    const db = getDb(env.DB);
    const settings = await db.select().from(siteSettings);
    settings.forEach((s) => {
      if (s.key === 'optical_name') opticalName = s.value;
      if (s.key === 'whatsapp_number') whatsappNumber = s.value;
    });

    const prods = await db.select().from(products).orderBy(desc(products.createdAt));
    const imgs = await db.select().from(productImages);

    allProducts = prods.map((p) => {
      const prodImgs = imgs.filter((i) => i.productId === p.id).sort((a, b) => a.orderIndex - b.orderIndex);
      return {
        ...p,
        primaryImage: prodImgs.find((i) => i.isPrimary)?.imageUrl || prodImgs[0]?.imageUrl || 'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=600&q=80',
      };
    });
  } catch (e) {
    console.error('Error fetching catalog:', e);
  }
}

const cleanWhatsapp = whatsappNumber.replace(/[^0-9]/g, '');

// Parámetros iniciales de URL si vienen desde el menú
const initialCategory = Astro.url.searchParams.get('category') || 'todos';
const initialWeekly = Astro.url.searchParams.get('weekly') === 'true';
---

<Layout title={`Catálogo de Lentes | ${opticalName}`}>
  <div class="bg-slate-900 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left">
      <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider block mb-2">Catálogo Oficial</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Armazones y Lentes</h1>
      <p class="text-slate-400 text-sm mt-1 max-w-xl">
        Descubre nuestra colección completa. Actualizada semanalmente con nuevos modelos listos para entrega inmediata o prueba en tienda.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Barra de Filtros y Búsqueda -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs mb-8 space-y-4">
      <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
        <!-- Input de Búsqueda -->
        <div class="w-full md:w-96 relative">
          <input
            type="text"
            id="catalog-search"
            placeholder="Buscar por marca, modelo o color..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Filtro Rápido: Novedades de la Semana -->
        <label class="flex items-center gap-2.5 px-4 py-2 rounded-xl bg-amber-50 border border-amber-200 cursor-pointer self-stretch md:self-auto justify-center">
          <input
            type="checkbox"
            id="filter-weekly"
            class="w-4 h-4 rounded text-amber-600 focus:ring-amber-500"
            checked={initialWeekly}
          />
          <span class="text-xs font-bold text-amber-900 uppercase tracking-wider">
            ✨ Solo Novedades de la Semana
          </span>
        </label>
      </div>

      <!-- Filtros de Categoría y Género -->
      <div class="pt-4 border-t border-slate-100 flex flex-wrap gap-3 items-center justify-between">
        <div class="flex flex-wrap gap-2 items-center">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">Categoría:</span>
          {['todos', 'opticos', 'sol', 'filtro-azul', 'infantil'].map((cat) => (
            <button
              class={`filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-semibold capitalize transition ${
                initialCategory === cat
                  ? 'bg-slate-900 text-white shadow-xs'
                  : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
              }`}
              data-cat={cat}
            >
              {cat === 'todos' ? 'Todos' : cat === 'opticos' ? 'Ópticos' : cat === 'sol' ? 'De Sol' : cat === 'filtro-azul' ? 'Filtro Azul' : 'Infantil'}
            </button>
          ))}
        </div>

        <div class="flex flex-wrap gap-2 items-center">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">Género:</span>
          {['todos', 'unisex', 'hombre', 'mujer'].map((gen) => (
            <button
              class={`filter-gen-btn px-3 py-1.5 rounded-xl text-xs font-semibold capitalize transition ${
                gen === 'todos' ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
              }`}
              data-gen={gen}
            >
              {gen === 'todos' ? 'Todos' : gen}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Grid de Lentes -->
    <div id="catalog-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {allProducts.map((p) => {
        const whatsappMsg = encodeURIComponent(
          `Hola ${opticalName}, me gustaría consultar disponibilidad del modelo ${p.name} (${p.brand}) que vi en su web.`
        );
        const consultLink = `https://wa.me/${cleanWhatsapp}?text=${whatsappMsg}`;

        return (
          <div
            class="product-card group bg-white rounded-3xl overflow-hidden border border-slate-200/80 hover:border-cyan-400 hover:shadow-xl transition-all duration-300 flex flex-col"
            data-name={p.name.toLowerCase()}
            data-brand={p.brand.toLowerCase()}
            data-model={p.modelCode ? p.modelCode.toLowerCase() : ''}
            data-color={p.color.toLowerCase()}
            data-cat={p.category.toLowerCase()}
            data-gender={p.gender.toLowerCase()}
            data-weekly={p.isWeeklyFeature ? 'true' : 'false'}
          >
            <!-- Imagen -->
            <a href={`/lentes/${p.id}`} class="relative block overflow-hidden bg-slate-50 aspect-[4/3]">
              <img
                src={p.primaryImage}
                alt={p.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              {p.isWeeklyFeature && (
                <span class="absolute top-3 left-3 bg-amber-500 text-white text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full shadow-xs">
                  ✨ Novedad
                </span>
              )}
              <span class={`absolute top-3 right-3 text-[10px] font-bold uppercase px-2 py-0.5 rounded-full ${
                p.status === 'in_stock' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'
              }`}>
                {p.status === 'in_stock' ? 'En Stock' : 'Agotado'}
              </span>
            </a>

            <!-- Contenido -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">{p.brand}</p>
                <a href={`/lentes/${p.id}`} class="block mt-0.5">
                  <h3 class="font-bold text-slate-900 group-hover:text-cyan-600 transition leading-snug line-clamp-1">
                    {p.name}
                  </h3>
                </a>
                <p class="text-xs text-slate-500 mt-1 line-clamp-1">
                  Color: {p.color} {p.dimensions ? `• ${p.dimensions}` : ''}
                </p>
              </div>

              <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
                <div>
                  {p.priceOnRequest ? (
                    <span class="text-xs font-semibold text-slate-500 italic">Consultar precio</span>
                  ) : (
                    <div>
                      <span class="text-[10px] text-slate-400 uppercase block">Precio</span>
                      <span class="text-base font-black text-slate-900">${p.price?.toLocaleString('es-CL')}</span>
                    </div>
                  )}
                </div>

                <div class="flex items-center gap-1.5">
                  <a
                    href={`/lentes/${p.id}`}
                    class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition"
                  >
                    Ficha
                  </a>
                  <a
                    href={consultLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white transition"
                    title="Consultar por WhatsApp"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Mensaje sin resultados -->
    <div id="no-results" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-800">No encontramos lentes con esos filtros</h3>
      <p class="text-sm text-slate-500 mt-1">Prueba seleccionando otra categoría o limpiando la búsqueda.</p>
      <button
        id="btn-reset-filters"
        class="mt-4 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-xl transition"
      >
        Limpiar Filtros
      </button>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
    const weeklyCheck = document.getElementById('filter-weekly') as HTMLInputElement;
    const catButtons = document.querySelectorAll('.filter-cat-btn') as NodeListOf<HTMLButtonElement>;
    const genButtons = document.querySelectorAll('.filter-gen-btn') as NodeListOf<HTMLButtonElement>;
    const cards = document.querySelectorAll('.product-card') as NodeListOf<HTMLDivElement>;
    const noResults = document.getElementById('no-results') as HTMLDivElement;
    const btnReset = document.getElementById('btn-reset-filters') as HTMLButtonElement;

    let selectedCat = 'todos';
    let selectedGen = 'todos';

    // Inicializar categoría activa según el botón que tenga la clase de activo
    catButtons.forEach((b) => {
      if (b.classList.contains('bg-slate-900')) {
        selectedCat = b.getAttribute('data-cat') || 'todos';
      }
    });

    function applyFilters() {
      const q = searchInput.value.toLowerCase().trim();
      const onlyWeekly = weeklyCheck.checked;
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const brand = card.getAttribute('data-brand') || '';
        const model = card.getAttribute('data-model') || '';
        const color = card.getAttribute('data-color') || '';
        const cat = card.getAttribute('data-cat') || '';
        const gen = card.getAttribute('data-gender') || '';
        const isWeekly = card.getAttribute('data-weekly') === 'true';

        const matchesQuery = !q || name.includes(q) || brand.includes(q) || model.includes(q) || color.includes(q);
        const matchesCat = selectedCat === 'todos' || cat === selectedCat;
        const matchesGen = selectedGen === 'todos' || gen === selectedGen;
        const matchesWeekly = !onlyWeekly || isWeekly;

        if (matchesQuery && matchesCat && matchesGen && matchesWeekly) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      noResults.classList.toggle('hidden', visibleCount > 0);
    }

    searchInput.addEventListener('input', applyFilters);
    weeklyCheck.addEventListener('change', applyFilters);

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => {
          b.classList.remove('bg-slate-900', 'text-white', 'shadow-xs');
          b.classList.add('bg-slate-100', 'text-slate-600');
        });
        btn.classList.add('bg-slate-900', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-slate-100', 'text-slate-600');
        selectedCat = btn.getAttribute('data-cat') || 'todos';
        applyFilters();
      });
    });

    genButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        genButtons.forEach((b) => {
          b.classList.remove('bg-slate-900', 'text-white', 'shadow-xs');
          b.classList.add('bg-slate-100', 'text-slate-600');
        });
        btn.classList.add('bg-slate-900', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-slate-100', 'text-slate-600');
        selectedGen = btn.getAttribute('data-gen') || 'todos';
        applyFilters();
      });
    });

    btnReset?.addEventListener('click', () => {
      searchInput.value = '';
      weeklyCheck.checked = false;
      catButtons[0].click();
      genButtons[0].click();
    });

    // Ejecutar filtro inicial
    applyFilters();
  </script>
</Layout>
