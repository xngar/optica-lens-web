---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, siteSettings } from '../../db';
import type { Env, AppUser } from '../../types';

const currentUser = Astro.locals.user as AppUser;
if (currentUser?.role !== 'admin') {
  return Astro.redirect('/admin?error=unauthorized');
}

const env = Astro.locals.runtime?.env as Env;
let config: Record<string, string> = {
  optical_name: 'Óptica Visión Moderna',
  whatsapp_number: '+56912345678',
  address: 'Av. Providencia 1234, Providencia, Santiago',
  business_hours: 'Lunes a Viernes 09:30 - 19:30 hrs | Sábados 10:00 - 14:00 hrs',
};

if (env?.DB) {
  try {
    const db = getDb(env.DB);
    const settings = await db.select().from(siteSettings);
    settings.forEach((s) => {
      config[s.key] = s.value;
    });
  } catch (e) {
    console.error('Error fetching settings:', e);
  }
}
---

<AdminLayout title="Configuración de la Óptica" activeTab="settings">
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Información de Contacto y Tienda</h2>
      <p class="text-xs text-slate-500 mt-0.5">
        Estos datos se muestran en la cabecera, el pie de página y en los enlaces automáticos de WhatsApp.
      </p>
    </div>

    <form id="settings-form" class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-xs space-y-5">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nombre de la Óptica</label>
        <input type="text" name="optical_name" value={config.optical_name} required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-cyan-500" />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Número de WhatsApp (con código de país)</label>
        <input type="text" name="whatsapp_number" value={config.whatsapp_number} required placeholder="+56912345678" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-cyan-500" />
        <p class="text-[11px] text-slate-400 mt-1">Este número recibirá las consultas directas generadas desde la ficha de cada lente.</p>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Dirección del Local Físico</label>
        <input type="text" name="address" value={config.address} required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-cyan-500" />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Horarios de Atención</label>
        <input type="text" name="business_hours" value={config.business_hours} required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-cyan-500" />
      </div>

      <div class="pt-4 flex justify-end">
        <button type="submit" id="btn-save-settings" class="px-6 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-sm shadow-sm transition">
          Guardar Configuración
        </button>
      </div>
    </form>
  </div>

  <script>
    const form = document.getElementById('settings-form') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload: Record<string, string> = {};
      fd.forEach((val, key) => {
        payload[key] = val as string;
      });

      try {
        const res = await fetch('/api/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          alert('¡Configuraciones guardadas exitosamente!');
          window.location.reload();
        } else {
          alert('Error al guardar configuraciones');
        }
      } catch (err: any) {
        alert('Error: ' + err.message);
      }
    });
  </script>
</AdminLayout>
