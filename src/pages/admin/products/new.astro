---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Nuevo Armazón" activeTab="new-product">
  <div class="max-w-4xl mx-auto">
    <div class="mb-6 flex items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold text-stone-900 tracking-tight">Ficha del Nuevo Armazón</h2>
        <p class="text-xs text-stone-500 mt-0.5">Completa las especificaciones técnicas y sube las fotografías al catálogo.</p>
      </div>
      <a href="/admin" class="text-xs font-medium text-stone-500 hover:text-stone-900 transition inline-flex items-center gap-1">
        <span>← Volver al listado</span>
      </a>
    </div>

    <form id="product-form" class="space-y-6">
      <!-- Sección 1: Información Principal -->
      <div class="bg-white p-6 rounded-2xl border border-stone-200/80 space-y-5">
        <h3 class="text-xs font-semibold text-stone-400 uppercase tracking-[0.15em]">
          1. Información General
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Nombre o Modelo Comercial *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Ej: Aviator Classic Polarized"
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-stone-50/40 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-stone-900"
            />
          </div>

          <div>
            <label for="brand" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Marca / Fabricante *
            </label>
            <input
              type="text"
              id="brand"
              name="brand"
              required
              placeholder="Ej: Ray-Ban, Oakley, Silhouette"
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-stone-50/40 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-stone-900"
            />
          </div>

          <div>
            <label for="modelCode" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Código / Referencia de Fábrica
            </label>
            <input
              type="text"
              id="modelCode"
              name="modelCode"
              placeholder="Ej: RB3025-001/58"
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-stone-50/40 text-sm tabular-nums focus:bg-white focus:outline-none focus:ring-2 focus:ring-stone-900"
            />
          </div>

          <div>
            <label for="category" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Categoría *
            </label>
            <select
              id="category"
              name="category"
              required
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-stone-900"
            >
              <option value="opticos">Lentes Ópticos / Graduados</option>
              <option value="sol">Lentes de Sol</option>
              <option value="filtro-azul">Filtro de Luz Azul (Pantallas)</option>
              <option value="lectura">Lentes de Lectura</option>
              <option value="infantil">Colección Infantil</option>
            </select>
          </div>

          <div>
            <label for="gender" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Público *
            </label>
            <select
              id="gender"
              name="gender"
              required
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-stone-900"
            >
              <option value="unisex">Unisex</option>
              <option value="hombre">Hombre</option>
              <option value="mujer">Mujer</option>
              <option value="infantil">Infantil</option>
            </select>
          </div>

          <div>
            <label for="color" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Color y Acabado *
            </label>
            <input
              type="text"
              id="color"
              name="color"
              required
              placeholder="Ej: Negro Mate / Carey Dorado"
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-stone-50/40 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-stone-900"
            />
          </div>
        </div>
      </div>

      <!-- Sección 2: Ficha Técnica -->
      <div class="bg-white p-6 rounded-2xl border border-stone-200/80 space-y-5">
        <h3 class="text-xs font-semibold text-stone-400 uppercase tracking-[0.15em]">
          2. Ficha Técnica y Medidas
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="frameMaterial" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Material del Armazón
            </label>
            <select
              id="frameMaterial"
              name="frameMaterial"
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-stone-900"
            >
              <option value="acetato">Acetato Italiano</option>
              <option value="metal">Metal / Acero Inox</option>
              <option value="titanio">Titanio Ultraliviano</option>
              <option value="tr90">TR90 Flexible</option>
              <option value="mixto">Mixto (Metal y Acetato)</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="frameShape" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Forma / Silueta
            </label>
            <select
              id="frameShape"
              name="frameShape"
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-stone-900"
            >
              <option value="cuadrado">Cuadrado</option>
              <option value="redondo">Redondo</option>
              <option value="aviador">Aviador</option>
              <option value="cat-eye">Cat-Eye (Ojo de Gato)</option>
              <option value="rectangular">Rectangular</option>
              <option value="geometrico">Geométrico</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="dimensions" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Medidas (Calibre-Puente-Varilla)
            </label>
            <input
              type="text"
              id="dimensions"
              name="dimensions"
              placeholder="Ej: 52-18-140"
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-stone-50/40 text-sm tabular-nums focus:bg-white focus:outline-none focus:ring-2 focus:ring-stone-900"
            />
          </div>
        </div>

        <div>
          <label for="description" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
            Descripción y Tratamientos Ópticos
          </label>
          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Detalles adicionales, tipo de cristales compatibles, peso, bisagras flex, etc."
            class="w-full px-3.5 py-2.5 rounded-xl border border-stone-200 bg-stone-50/40 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-stone-900"
          ></textarea>
        </div>
      </div>

      <!-- Sección 3: Precio, Stock y Novedad Semanal -->
      <div class="bg-white p-6 rounded-2xl border border-stone-200/80 space-y-5">
        <h3 class="text-xs font-semibold text-stone-400 uppercase tracking-[0.15em]">
          3. Precio, Stock y Destacado
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-start">
          <div>
            <label for="price-input" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Precio (CLP)
            </label>
            <input
              type="number"
              name="price"
              id="price-input"
              placeholder="Ej: 89990"
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-stone-50/40 text-sm tabular-nums focus:bg-white focus:outline-none focus:ring-2 focus:ring-stone-900 disabled:opacity-50"
            />
            <label class="mt-2.5 flex items-center gap-2 cursor-pointer text-xs text-stone-600 select-none">
              <input type="checkbox" name="priceOnRequest" id="price-on-request" class="rounded border-stone-300 text-stone-900 focus:ring-stone-900" />
              <span>Precio a consultar en tienda</span>
            </label>
          </div>

          <div>
            <label for="status" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">
              Disponibilidad
            </label>
            <select
              id="status"
              name="status"
              class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-stone-900"
            >
              <option value="in_stock">En Stock Inmediato</option>
              <option value="out_of_stock">Agotado Temporalmente</option>
              <option value="preorder">Bajo Pedido</option>
            </select>
          </div>

          <div class="p-4 rounded-xl bg-amber-50/60 border border-amber-200/80">
            <label class="flex items-start gap-3 cursor-pointer select-none">
              <input
                type="checkbox"
                name="isWeeklyFeature"
                class="mt-0.5 size-4 rounded border-amber-300 text-stone-900 focus:ring-stone-900"
                checked
              />
              <div>
                <span class="block text-xs font-semibold text-amber-900 uppercase tracking-wider">
                  Destacar en la Semana
                </span>
                <span class="text-xs text-amber-800/80 mt-0.5 block leading-relaxed">
                  Se mostrará en la sección "Novedades de la Semana" de la portada.
                </span>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Sección 4: Subida de Fotos -->
      <div class="bg-white p-6 rounded-2xl border border-stone-200/80 space-y-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-xs font-semibold text-stone-400 uppercase tracking-[0.15em]">4. Fotografías del Armazón</h3>
            <p class="text-xs text-stone-500 mt-1">
              Compresión automática a formato WebP optimizado antes de subir a Cloudflare R2.
            </p>
          </div>
          <span class="text-[11px] font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200/80 px-2.5 py-1 rounded-full shrink-0">
            WebP Automático
          </span>
        </div>

        <div
          id="dropzone"
          class="border-2 border-dashed border-stone-300 hover:border-stone-900 rounded-2xl p-8 text-center cursor-pointer transition-colors bg-stone-50/50 hover:bg-stone-100/40"
        >
          <input
            type="file"
            id="file-input"
            accept="image/*"
            multiple
            class="hidden"
          />
          <div class="size-11 rounded-full bg-stone-200/70 text-stone-700 flex items-center justify-center mx-auto mb-3">
            <svg class="size-5" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-stone-800">Arrastra las fotografías aquí o haz clic para seleccionar</p>
          <p class="text-xs text-stone-400 mt-1">Soporta JPG, PNG y WEBP. Puedes subir múltiples vistas.</p>
        </div>

        <div id="image-preview-container" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-4 hidden"></div>

        <div id="upload-status" role="status" aria-live="polite" class="hidden text-xs font-medium text-stone-700 p-3.5 rounded-xl bg-stone-100 border border-stone-200">
          <span id="upload-status-text">Procesando y subiendo imágenes...</span>
        </div>
      </div>

      <!-- Barra de Envío -->
      <div class="flex items-center justify-end gap-3 pt-2">
        <a
          href="/admin"
          class="px-5 py-2.5 min-h-11 rounded-full border border-stone-300 text-xs font-semibold text-stone-700 hover:bg-stone-100 transition inline-flex items-center"
        >
          Cancelar
        </a>
        <button
          type="submit"
          id="btn-save"
          class="px-7 py-2.5 min-h-11 rounded-full bg-stone-900 hover:bg-stone-800 text-white text-xs font-semibold uppercase tracking-wider transition inline-flex items-center gap-2 cursor-pointer"
        >
          <span id="btn-save-text">Publicar en Catálogo</span>
          <svg id="btn-save-spinner" class="hidden animate-spin size-4 text-white" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>

  <script>
    import { optimizeImageForUpload } from '../../../lib/image-optimizer';

    const dropzone = document.getElementById('dropzone') as HTMLDivElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const previewContainer = document.getElementById('image-preview-container') as HTMLDivElement;
    const uploadStatus = document.getElementById('upload-status') as HTMLDivElement;
    const uploadStatusText = document.getElementById('upload-status-text') as HTMLSpanElement;
    const productForm = document.getElementById('product-form') as HTMLFormElement;
    const btnSave = document.getElementById('btn-save') as HTMLButtonElement;
    const btnSaveText = document.getElementById('btn-save-text') as HTMLSpanElement;
    const btnSaveSpinner = document.getElementById('btn-save-spinner') as HTMLElement;
    const priceOnRequest = document.getElementById('price-on-request') as HTMLInputElement;
    const priceInput = document.getElementById('price-input') as HTMLInputElement;
    const toast = document.getElementById('admin-toast');

    function showToast(msg: string) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 3500);
    }

    priceOnRequest.addEventListener('change', () => {
      if (priceOnRequest.checked) {
        priceInput.value = '';
        priceInput.disabled = true;
      } else {
        priceInput.disabled = false;
      }
    });

    const uploadedImageUrls: string[] = [];

    dropzone.addEventListener('click', () => fileInput.click());

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-stone-900', 'bg-stone-100');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-stone-900', 'bg-stone-100');
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-stone-900', 'bg-stone-100');
      if (e.dataTransfer?.files) {
        handleFiles(Array.from(e.dataTransfer.files));
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files) {
        handleFiles(Array.from(fileInput.files));
      }
    });

    async function handleFiles(files: File[]) {
      if (files.length === 0) return;

      uploadStatus.classList.remove('hidden');
      uploadStatusText.textContent = `Optimizando y subiendo ${files.length} fotografía(s)...`;

      try {
        const formData = new FormData();

        for (const file of files) {
          uploadStatusText.textContent = `Comprimiendo "${file.name}" a WebP...`;
          const optimizedFile = await optimizeImageForUpload(file);
          formData.append('files', optimizedFile);
        }

        uploadStatusText.textContent = `Subiendo a Cloudflare R2...`;
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData,
        });

        const data: any = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Error al subir fotos');
        }

        const urls = data.urls || [data.url];
        urls.forEach((url: string) => {
          uploadedImageUrls.push(url);
          renderPreview(url);
        });

        uploadStatus.classList.add('hidden');
      } catch (err: any) {
        showToast('Error al subir fotos: ' + err.message);
        uploadStatus.classList.add('hidden');
      }
    }

    function renderPreview(url: string) {
      previewContainer.classList.remove('hidden');
      const card = document.createElement('div');
      card.className = 'relative group rounded-xl overflow-hidden border border-stone-200 bg-stone-100 aspect-square';
      card.innerHTML = `
        <img src="${url}" alt="Vista previa" class="w-full h-full object-cover" />
        <button type="button" aria-label="Quitar imagen" class="absolute top-2 right-2 bg-stone-900/90 text-white size-7 rounded-full inline-flex items-center justify-center hover:bg-rose-600 transition cursor-pointer" title="Quitar">
          ✕
        </button>
      `;

      card.querySelector('button')?.addEventListener('click', () => {
        const idx = uploadedImageUrls.indexOf(url);
        if (idx !== -1) uploadedImageUrls.splice(idx, 1);
        card.remove();
        if (uploadedImageUrls.length === 0) {
          previewContainer.classList.add('hidden');
        }
      });

      previewContainer.appendChild(card);
    }

    productForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      btnSave.disabled = true;
      btnSaveText.textContent = 'Guardando...';
      btnSaveSpinner.classList.remove('hidden');

      const formData = new FormData(productForm);
      const payload = {
        name: formData.get('name'),
        brand: formData.get('brand'),
        modelCode: formData.get('modelCode'),
        category: formData.get('category'),
        gender: formData.get('gender'),
        color: formData.get('color'),
        frameMaterial: formData.get('frameMaterial'),
        frameShape: formData.get('frameShape'),
        dimensions: formData.get('dimensions'),
        description: formData.get('description'),
        price: formData.get('price') ? Number(formData.get('price')) : null,
        priceOnRequest: formData.get('priceOnRequest') === 'on',
        status: formData.get('status'),
        isWeeklyFeature: formData.get('isWeeklyFeature') === 'on',
        images: uploadedImageUrls,
      };

      try {
        const res = await fetch('/api/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data: any = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Error al guardar el producto');
        }

        window.location.href = '/admin';
      } catch (err: any) {
        showToast('Error: ' + err.message);
        btnSave.disabled = false;
        btnSaveText.textContent = 'Publicar en Catálogo';
        btnSaveSpinner.classList.add('hidden');
      }
    });
  </script>
</AdminLayout>
