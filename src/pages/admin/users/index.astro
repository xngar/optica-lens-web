---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb, user as userTable } from '../../../db';
import { desc } from 'drizzle-orm';
import type { Env, AppUser } from '../../../types';

const currentUser = Astro.locals.user as AppUser;
if (currentUser?.role !== 'admin') {
  return Astro.redirect('/admin?error=unauthorized');
}

const env = Astro.locals.runtime?.env as Env;
let usersList: any[] = [];

if (env?.DB) {
  try {
    const db = getDb(env.DB);
    usersList = await db
      .select({
        id: userTable.id,
        name: userTable.name,
        email: userTable.email,
        role: userTable.role,
        createdAt: userTable.createdAt,
      })
      .from(userTable)
      .orderBy(desc(userTable.createdAt));
  } catch (e) {
    console.error('Error fetching users:', e);
  }
}
---

<AdminLayout title="Personal y Accesos" activeTab="users">
  <div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h2 class="text-xl font-semibold text-stone-900 tracking-tight">Equipo y Cuentas de Acceso</h2>
        <p class="text-xs text-stone-500 mt-0.5">
          Gestiona los permisos de acceso para el personal de la óptica.
        </p>
      </div>
      <button
        type="button"
        id="btn-open-create-modal"
        class="inline-flex items-center gap-2 px-5 py-2.5 min-h-10 rounded-full bg-stone-900 hover:bg-stone-800 text-white font-semibold text-xs tracking-wide transition cursor-pointer"
      >
        <svg class="size-4" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span>Agregar Personal</span>
      </button>
    </div>

    <!-- Tabla de Usuarios -->
    <div class="bg-white rounded-2xl border border-stone-200/80 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-stone-50/80 text-[11px] font-semibold text-stone-500 uppercase tracking-[0.12em] border-b border-stone-200/80">
              <th class="py-3.5 px-6">Nombre</th>
              <th class="py-3.5 px-6">Correo Electrónico</th>
              <th class="py-3.5 px-6">Rol</th>
              <th class="py-3.5 px-6">Permisos</th>
              <th class="py-3.5 px-6 text-right">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100 text-sm">
            {usersList.map((u) => {
              const isSelf = u.id === currentUser.id;
              const isAdmin = u.role === 'admin';
              return (
                <tr class="hover:bg-stone-50/70 transition-colors">
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-3">
                      <div class="size-8 rounded-full bg-stone-900 text-white font-semibold flex items-center justify-center text-xs shrink-0">
                        {u.name.charAt(0).toUpperCase()}
                      </div>
                      <p class="font-semibold text-stone-900">
                        {u.name} {isSelf && <span class="text-xs text-stone-400 font-normal">(Tú)</span>}
                      </p>
                    </div>
                  </td>
                  <td class="py-4 px-6 text-stone-600">{u.email}</td>
                  <td class="py-4 px-6">
                    <span
                      class={`px-2.5 py-1 text-xs font-semibold rounded-full border ${
                        isAdmin
                          ? 'bg-stone-900 text-white border-stone-900'
                          : 'bg-stone-100 text-stone-700 border-stone-200'
                      }`}
                    >
                      {isAdmin ? 'Administrador' : 'Personal Óptica'}
                    </span>
                  </td>
                  <td class="py-4 px-6 text-xs text-stone-500">
                    {isAdmin ? 'Control total + Usuarios' : 'Gestión de catálogo y stock'}
                  </td>
                  <td class="py-4 px-6 text-right">
                    {isSelf ? (
                      <span class="text-xs text-stone-400">Sesión activa</span>
                    ) : (
                      <button
                        type="button"
                        class="btn-delete-user text-xs font-semibold text-rose-600 hover:text-rose-800 hover:bg-rose-50 px-3 py-1.5 rounded-lg transition cursor-pointer"
                        data-id={u.id}
                        data-name={u.name}
                      >
                        Revocar Acceso
                      </button>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal accesible para Crear Nuevo Usuario -->
    <div
      id="modal-create-user"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-user-title"
      class="fixed inset-0 bg-stone-950/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden"
    >
      <div class="bg-white rounded-2xl p-6 sm:p-8 max-w-md w-full shadow-xl border border-stone-200">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h3 id="modal-user-title" class="text-lg font-semibold text-stone-900">Dar de Alta Personal</h3>
            <p class="text-xs text-stone-500 mt-0.5">Crea una cuenta para gestionar el catálogo de lentes.</p>
          </div>
          <button
            type="button"
            id="btn-close-modal"
            aria-label="Cerrar ventana"
            class="size-9 inline-flex items-center justify-center text-stone-400 hover:text-stone-700 hover:bg-stone-100 rounded-full cursor-pointer"
          >
            ✕
          </button>
        </div>

        <form id="form-create-user" class="space-y-4">
          <div>
            <label for="new-user-name" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">Nombre Completo *</label>
            <input type="text" id="new-user-name" name="name" required placeholder="Ej: Marcela Gómez" class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-stone-900" />
          </div>

          <div>
            <label for="new-user-email" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">Correo Electrónico *</label>
            <input type="email" id="new-user-email" name="email" required placeholder="marcela@optica.com" class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-stone-900" />
          </div>

          <div>
            <label for="new-user-password" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">Contraseña Inicial *</label>
            <input type="password" id="new-user-password" name="password" required placeholder="Mínimo 8 caracteres" class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-stone-900" />
          </div>

          <div>
            <label for="new-user-role" class="block text-[11px] font-semibold text-stone-700 uppercase tracking-wider mb-1.5">Rol en el Sistema *</label>
            <select id="new-user-role" name="role" class="w-full px-3.5 py-2.5 min-h-11 rounded-xl border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-stone-900 bg-white">
              <option value="staff" selected>Personal de Óptica (Gestión de catálogo)</option>
              <option value="admin">Administrador (Control total + Usuarios)</option>
            </select>
          </div>

          <div class="pt-4 flex items-center justify-end gap-2.5">
            <button type="button" id="btn-cancel-modal" class="px-4 py-2.5 min-h-10 rounded-full border border-stone-300 text-xs font-semibold text-stone-700 hover:bg-stone-100 transition cursor-pointer">Cancelar</button>
            <button type="submit" id="btn-submit-user" class="px-5 py-2.5 min-h-10 rounded-full bg-stone-900 hover:bg-stone-800 text-white text-xs font-semibold uppercase tracking-wider transition cursor-pointer">Crear Acceso</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('modal-create-user') as HTMLDivElement;
    const btnOpen = document.getElementById('btn-open-create-modal') as HTMLButtonElement;
    const btnClose = document.getElementById('btn-close-modal') as HTMLButtonElement;
    const btnCancel = document.getElementById('btn-cancel-modal') as HTMLButtonElement;
    const form = document.getElementById('form-create-user') as HTMLFormElement;
    const firstInput = document.getElementById('new-user-name') as HTMLInputElement;
    const toast = document.getElementById('admin-toast');

    function showToast(msg: string) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 3500);
    }

    function openModal() {
      modal.classList.remove('hidden');
      firstInput?.focus();
    }

    function closeModal() {
      modal.classList.add('hidden');
      btnOpen?.focus();
    }

    btnOpen?.addEventListener('click', openModal);
    btnClose?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = {
        name: fd.get('name'),
        email: fd.get('email'),
        password: fd.get('password'),
        role: fd.get('role'),
      };

      try {
        const res = await fetch('/api/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data: any = await res.json();
        if (res.ok) {
          closeModal();
          showToast('Personal registrado exitosamente');
          setTimeout(() => window.location.reload(), 600);
        } else {
          showToast(data.error || 'Error al crear usuario');
        }
      } catch (err: any) {
        showToast('Error: ' + err.message);
      }
    });

    document.querySelectorAll('.btn-delete-user').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        if (!id) return;

        if (confirm(`¿Revocar acceso al usuario "${name}"?`)) {
          try {
            const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
            if (res.ok) {
              showToast(`Acceso revocado para ${name}`);
              setTimeout(() => window.location.reload(), 600);
            } else {
              const d: any = await res.json();
              showToast(d.error || 'Error al eliminar usuario');
            }
          } catch (err: any) {
            showToast('Error: ' + err.message);
          }
        }
      });
    });
  </script>
</AdminLayout>
