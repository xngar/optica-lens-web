---
import Layout from '../layouts/Layout.astro';
import { getDb, products, productImages, siteSettings } from '../db';
import { desc, eq } from 'drizzle-orm';
import type { Env } from '../types';

const env = Astro.locals.runtime?.env as Env;
let weeklyProducts: any[] = [];
let opticalName = 'Óptica Visión Moderna';
let whatsappNumber = '+56912345678';

if (env?.DB) {
  try {
    const db = getDb(env.DB);
    const settings = await db.select().from(siteSettings);
    settings.forEach((s) => {
      if (s.key === 'optical_name') opticalName = s.value;
      if (s.key === 'whatsapp_number') whatsappNumber = s.value;
    });

    const prods = await db
      .select()
      .from(products)
      .where(eq(products.isWeeklyFeature, true))
      .orderBy(desc(products.createdAt))
      .limit(6);

    const imgs = await db.select().from(productImages);

    weeklyProducts = prods.map((p) => {
      const prodImgs = imgs.filter((i) => i.productId === p.id).sort((a, b) => a.orderIndex - b.orderIndex);
      return {
        ...p,
        primaryImage:
          prodImgs.find((i) => i.isPrimary)?.imageUrl ||
          prodImgs[0]?.imageUrl ||
          'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=600&q=80',
      };
    });
  } catch (e) {
    console.error('Error fetching weekly products:', e);
  }
}

const cleanWhatsapp = whatsappNumber.replace(/[^0-9]/g, '');
---

<Layout title={`${opticalName} | Lentes Ópticos, de Sol y Filtro Azul`}>
  <!-- Hero Full-Bleed 100vw x 100vh con imagen publicitaria close-up de fondo -->
  <section class="relative w-screen min-h-dvh h-dvh left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] overflow-hidden flex items-center border-b border-zinc-200/80">
    <!-- Imagen publicitaria close-up de fondo -->
    <img
      src="/hero-eyewear.jpg"
      alt="Campaña de lentes ópticos modernos"
      width="1920"
      height="1080"
      class="absolute inset-0 w-full h-full object-cover object-[70%_center] sm:object-center select-none"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Velo suave lateral para garantizar legibilidad perfecta del texto sin tapar a la modelo -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-white/95 via-white/75 to-white/30 lg:bg-gradient-to-r lg:from-white/85 lg:via-white/45 lg:to-transparent"
      aria-hidden="true"
    ></div>

    <!-- Contenido principal del Hero -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-xl space-y-6 text-center lg:text-left">
        <h1 class="font-display text-4xl sm:text-6xl lg:text-[68px] font-extrabold text-zinc-950 tracking-tight leading-[1.02] text-balance">
          Ver bien se siente <span class="text-blue-600">increíble</span>.
        </h1>

        <p class="text-base sm:text-lg text-zinc-700 max-w-lg mx-auto lg:mx-0 font-medium leading-relaxed">
          Armazones con onda, cristales de alta precisión y asesoría óptica sin complicaciones. Elige tus favoritos en el catálogo online y ven a probártelos a nuestra óptica.
        </p>

        <!-- CTAs principales -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
          <a
            href="/catalogo"
            class="w-full sm:w-auto px-8 py-4 min-h-12 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-sm uppercase tracking-wider shadow-lg shadow-blue-600/25 hover:-translate-y-0.5 transition-all duration-200 text-center inline-flex items-center justify-center gap-2"
          >
            <span>Ver Todo el Catálogo</span>
            <svg class="size-4" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="/catalogo?weekly=true"
            class="w-full sm:w-auto px-7 py-4 min-h-12 rounded-full bg-zinc-950 hover:bg-zinc-800 text-white font-extrabold text-sm uppercase tracking-wider hover:-translate-y-0.5 transition-all duration-200 text-center inline-flex items-center justify-center gap-2"
          >
            <span>Novedades de la Semana</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento de Categorías Rápidas (Sin badges) -->
  <section class="py-16 bg-white border-b border-zinc-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-10">
        <div>
          <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
            Elige por categoría
          </h2>
        </div>
        <a href="/catalogo" class="text-sm font-bold text-zinc-600 hover:text-blue-600 transition-colors">
          Ver todas las categorías →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Ópticos -->
        <a
          href="/catalogo?category=opticos"
          class="group relative overflow-hidden bg-zinc-100 hover:bg-blue-600 p-7 rounded-3xl transition-all duration-200 hover:-translate-y-1 flex flex-col justify-between min-h-[200px]"
        >
          <div class="size-12 rounded-2xl bg-white text-zinc-950 flex items-center justify-center shadow-xs">
            <svg class="size-6" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6.5" cy="14" r="3.5" />
              <circle cx="17.5" cy="14" r="3.5" />
              <path d="M10 14h4" />
              <path d="M3 14V9a2 2 0 0 1 2-2h1" />
              <path d="M21 14V9a2 2 0 0 0-2-2h-1" />
            </svg>
          </div>
          <div class="mt-6">
            <h3 class="font-display font-extrabold text-zinc-950 group-hover:text-white text-xl transition-colors">
              Lentes Ópticos
            </h3>
            <p class="text-xs font-medium text-zinc-600 group-hover:text-blue-100 mt-1 transition-colors">
              Marcos livianos y resistentes para tu día a día.
            </p>
          </div>
        </a>

        <!-- Sol -->
        <a
          href="/catalogo?category=sol"
          class="group relative overflow-hidden bg-amber-50 hover:bg-amber-400 p-7 rounded-3xl transition-all duration-200 hover:-translate-y-1 flex flex-col justify-between min-h-[200px]"
        >
          <div class="size-12 rounded-2xl bg-white text-zinc-950 flex items-center justify-center shadow-xs">
            <svg class="size-6" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
          </div>
          <div class="mt-6">
            <h3 class="font-display font-extrabold text-zinc-950 text-xl">
              Lentes de Sol
            </h3>
            <p class="text-xs font-medium text-zinc-700 mt-1">
              Con y sin graduación para cuidar tu vista con estilo.
            </p>
          </div>
        </a>

        <!-- Filtro Azul -->
        <a
          href="/catalogo?category=filtro-azul"
          class="group relative overflow-hidden bg-blue-50 hover:bg-zinc-950 p-7 rounded-3xl transition-all duration-200 hover:-translate-y-1 flex flex-col justify-between min-h-[200px]"
        >
          <div class="size-12 rounded-2xl bg-white text-blue-600 flex items-center justify-center shadow-xs">
            <svg class="size-6" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
            </svg>
          </div>
          <div class="mt-6">
            <h3 class="font-display font-extrabold text-zinc-950 group-hover:text-white text-xl transition-colors">
              Filtro Luz Azul
            </h3>
            <p class="text-xs font-medium text-zinc-600 group-hover:text-zinc-300 mt-1 transition-colors">
              Menos fatiga visual frente al notebook y celular.
            </p>
          </div>
        </a>

        <!-- Infantil -->
        <a
          href="/catalogo?category=infantil"
          class="group relative overflow-hidden bg-emerald-50 hover:bg-emerald-500 p-7 rounded-3xl transition-all duration-200 hover:-translate-y-1 flex flex-col justify-between min-h-[200px]"
        >
          <div class="size-12 rounded-2xl bg-white text-emerald-600 flex items-center justify-center shadow-xs">
            <svg class="size-6" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" />
            </svg>
          </div>
          <div class="mt-6">
            <h3 class="font-display font-extrabold text-zinc-950 group-hover:text-white text-xl transition-colors">
              Línea Kids
            </h3>
            <p class="text-xs font-medium text-zinc-600 group-hover:text-emerald-50 mt-1 transition-colors">
              Súper flexibles, cómodos y listos para jugar.
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Sección: Novedades de la Semana (Sin badges) -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-10">
        <div>
          <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
            Novedades de la Semana
          </h2>
        </div>
        <a
          href="/catalogo?weekly=true"
          class="px-5 py-2.5 rounded-full bg-zinc-100 hover:bg-zinc-950 hover:text-white text-zinc-900 text-xs font-extrabold uppercase tracking-wider inline-flex items-center gap-2 transition-colors"
        >
          <span>Ver todos ({weeklyProducts.length})</span>
          <svg class="size-4" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">
        {weeklyProducts.map((p) => {
          const whatsappMsg = encodeURIComponent(
            `Hola ${opticalName}, me encantó el modelo ${p.name} (${p.brand}) que vi en Novedades de la Semana. ¿Está disponible para ir a probarlo?`
          );
          const consultLink = `https://wa.me/${cleanWhatsapp}?text=${whatsappMsg}`;

          return (
            <article class="group bg-white rounded-3xl overflow-hidden border border-zinc-200 hover:border-zinc-950 hover:-translate-y-1 hover:shadow-xl transition-all duration-200 flex flex-col">
              <!-- Foto limpia sin badges -->
              <a
                href={`/lentes/${p.id}`}
                class="relative block overflow-hidden bg-zinc-100 aspect-[4/3] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              >
                <img
                  src={p.primaryImage}
                  alt={`${p.name} - ${p.brand}`}
                  width="600"
                  height="450"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>

              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-xs font-extrabold text-blue-600 uppercase tracking-wider">{p.brand}</p>
                    <span class="text-[11px] font-semibold text-zinc-400">{p.color}</span>
                  </div>
                  <a href={`/lentes/${p.id}`} class="block mt-1">
                    <h3 class="font-display text-xl font-extrabold text-zinc-950 group-hover:text-blue-600 transition-colors leading-snug">
                      {p.name}
                    </h3>
                  </a>
                  <p class="text-xs text-zinc-500 mt-1.5 line-clamp-2">
                    {p.description || `Armazón ${p.frameMaterial || ''} en color ${p.color}.`}
                  </p>
                </div>

                <div class="pt-5 mt-5 border-t border-zinc-100 flex items-center justify-between gap-3">
                  <div>
                    {p.priceOnRequest ? (
                      <span class="text-xs font-bold text-zinc-500">Consultar precio</span>
                    ) : (
                      <div>
                        <span class="text-[10px] font-bold text-zinc-400 uppercase block">Precio marco</span>
                        <span class="font-display text-2xl font-extrabold text-zinc-950 tabular-nums">
                          ${p.price?.toLocaleString('es-CL')}
                        </span>
                      </div>
                    )}
                  </div>

                  <div class="flex items-center gap-2">
                    <a
                      href={`/lentes/${p.id}`}
                      class="px-4 py-2.5 min-h-10 rounded-full bg-zinc-100 hover:bg-zinc-950 hover:text-white text-zinc-950 text-xs font-extrabold uppercase tracking-wider transition-colors inline-flex items-center"
                    >
                      Ver más
                    </a>
                    <a
                      href={consultLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Consultar por ${p.name} en WhatsApp`}
                      title="Consultar disponibilidad por WhatsApp"
                      class="px-4 py-2.5 min-h-10 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-extrabold uppercase tracking-wider transition-colors inline-flex items-center gap-1.5"
                    >
                      <svg class="size-4 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
                      </svg>
                      <span>Probar</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Banner Asesoría (Sin badges) -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-blue-600 rounded-3xl p-8 sm:p-12 lg:p-16 text-white flex flex-col lg:flex-row items-center justify-between gap-8 shadow-xl shadow-blue-600/15">
        <div class="max-w-2xl space-y-4 text-center lg:text-left">
          <h2 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight text-balance">
            ¿No sabes qué forma le queda mejor a tu cara?
          </h2>
          <p class="text-blue-100 text-sm sm:text-base font-medium leading-relaxed">
            Mándanos un WhatsApp con tu receta o el modelo que te gustó y te ayudamos a elegir cristales y marco al instante.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3.5 w-full lg:w-auto shrink-0">
          <a
            href={`https://wa.me/${cleanWhatsapp}?text=${encodeURIComponent(`Hola ${opticalName}, quiero asesoría para elegir mis lentes.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 min-h-12 rounded-full bg-zinc-950 hover:bg-zinc-900 font-extrabold text-white text-sm uppercase tracking-wider transition-all inline-flex items-center justify-center gap-2"
          >
            <span>Hablar por WhatsApp</span>
          </a>
          <a
            href="/catalogo"
            class="w-full sm:w-auto px-7 py-4 min-h-12 rounded-full bg-white hover:bg-blue-50 text-zinc-950 font-extrabold text-sm uppercase tracking-wider transition-all inline-flex items-center justify-center"
          >
            Mirar Catálogo
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
