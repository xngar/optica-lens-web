---
import '../styles/global.css';
import type { AppUser } from '../types';

interface Props {
  title?: string;
  activeTab?: 'products' | 'new-product' | 'users' | 'settings';
}

const { title = 'Panel de Administración | Óptica', activeTab = 'products' } = Astro.props;
const user = Astro.locals.user as AppUser;
const isAdmin = user?.role === 'admin';
---

<!doctype html>
<html lang="es" class="h-full bg-[#FAFAF9]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="h-full flex flex-col md:flex-row text-stone-900">
    <!-- Sidebar Minimal Swiss -->
    <aside class="w-full md:w-64 bg-stone-950 text-stone-300 flex flex-col shrink-0 border-b md:border-b-0 md:border-r border-stone-800">
      <!-- Marca -->
      <div class="h-16 md:h-20 px-6 flex items-center justify-between border-b border-stone-800/80">
        <a href="/admin" class="flex items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white rounded-lg">
          <div class="size-9 rounded-full bg-white text-stone-950 flex items-center justify-center">
            <svg class="size-4" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6.5" cy="14" r="3.5" />
              <circle cx="17.5" cy="14" r="3.5" />
              <path d="M10 14h4" />
            </svg>
          </div>
          <div>
            <span class="font-semibold text-white tracking-tight block text-sm leading-none">Óptica Panel</span>
            <span class="text-[10px] text-stone-400 font-medium uppercase tracking-[0.15em] block mt-1">
              {isAdmin ? 'Administrador' : 'Personal'}
            </span>
          </div>
        </a>
      </div>

      <!-- Menú -->
      <nav class="flex-1 p-4 space-y-1 overflow-y-auto" aria-label="Menú de administración">
        <a
          href="/admin"
          aria-current={activeTab === 'products' ? 'page' : undefined}
          class={`flex items-center gap-3 px-3.5 py-2.5 min-h-10 rounded-xl text-xs font-medium transition-colors ${
            activeTab === 'products'
              ? 'bg-white text-stone-950 font-semibold'
              : 'text-stone-400 hover:bg-stone-900 hover:text-white'
          }`}
        >
          <svg class="size-4 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
          </svg>
          <span>Catálogo de Lentes</span>
        </a>

        <a
          href="/admin/products/new"
          aria-current={activeTab === 'new-product' ? 'page' : undefined}
          class={`flex items-center gap-3 px-3.5 py-2.5 min-h-10 rounded-xl text-xs font-medium transition-colors ${
            activeTab === 'new-product'
              ? 'bg-white text-stone-950 font-semibold'
              : 'text-stone-400 hover:bg-stone-900 hover:text-white'
          }`}
        >
          <svg class="size-4 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          <span>Nuevo Armazón</span>
        </a>

        {isAdmin && (
          <div class="pt-5 pb-1.5">
            <p class="px-3.5 text-[10px] font-semibold text-stone-500 uppercase tracking-[0.18em]">Sistema</p>
          </div>
        )}

        {isAdmin && (
          <a
            href="/admin/users"
            aria-current={activeTab === 'users' ? 'page' : undefined}
            class={`flex items-center gap-3 px-3.5 py-2.5 min-h-10 rounded-xl text-xs font-medium transition-colors ${
              activeTab === 'users'
                ? 'bg-white text-stone-950 font-semibold'
                : 'text-stone-400 hover:bg-stone-900 hover:text-white'
            }`}
          >
            <svg class="size-4 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
            <span>Personal y Accesos</span>
          </a>
        )}

        {isAdmin && (
          <a
            href="/admin/settings"
            aria-current={activeTab === 'settings' ? 'page' : undefined}
            class={`flex items-center gap-3 px-3.5 py-2.5 min-h-10 rounded-xl text-xs font-medium transition-colors ${
              activeTab === 'settings'
                ? 'bg-white text-stone-950 font-semibold'
                : 'text-stone-400 hover:bg-stone-900 hover:text-white'
            }`}
          >
            <svg class="size-4 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Datos de la Óptica</span>
          </a>
        )}

        <div class="pt-5">
          <a
            href="/"
            target="_blank"
            class="flex items-center gap-3 px-3.5 py-2.5 min-h-10 rounded-xl text-xs font-medium text-stone-400 hover:bg-stone-900 hover:text-white transition-colors"
          >
            <svg class="size-4 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
            <span>Ver Sitio Público</span>
          </a>
        </div>
      </nav>

      <!-- Perfil y Logout (Separado visualmente - destructive-nav-separation) -->
      <div class="p-4 border-t border-stone-800/80 flex items-center justify-between gap-2">
        <div class="flex items-center gap-3 min-w-0">
          <div class="size-8 rounded-full bg-stone-800 text-stone-200 text-xs font-semibold flex items-center justify-center shrink-0">
            {user?.name?.charAt(0).toUpperCase() || 'U'}
          </div>
          <div class="min-w-0">
            <p class="text-xs font-semibold text-white truncate">{user?.name}</p>
            <p class="text-[11px] text-stone-400 truncate">{user?.email}</p>
          </div>
        </div>

        <button
          type="button"
          id="btn-logout"
          aria-label="Cerrar sesión"
          title="Cerrar Sesión"
          class="size-9 inline-flex items-center justify-center text-stone-400 hover:text-rose-400 hover:bg-stone-900 rounded-lg transition-colors cursor-pointer shrink-0"
        >
          <svg class="size-4" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
          </svg>
        </button>
      </div>
    </aside>

    <!-- Área de Trabajo Principal -->
    <div class="flex-1 flex flex-col min-h-dvh overflow-y-auto">
      <header class="bg-white border-b border-stone-200/80 px-6 py-4 flex items-center justify-between shrink-0">
        <div>
          <h1 class="text-lg font-semibold text-stone-900 tracking-tight">{title}</h1>
        </div>
        <div class="flex items-center gap-3">
          <span
            class={`px-3 py-1 text-[11px] font-semibold rounded-full border ${
              isAdmin
                ? 'bg-stone-900 text-white border-stone-900'
                : 'bg-stone-100 text-stone-700 border-stone-200'
            }`}
          >
            {isAdmin ? 'Administrador' : 'Personal Óptica'}
          </span>
        </div>
      </header>

      <main class="flex-1 p-6 md:p-8">
        <slot />
      </main>
    </div>

    <!-- Región global de notificaciones Toast accesibles -->
    <div
      id="admin-toast"
      role="status"
      aria-live="polite"
      class="fixed bottom-5 right-5 z-50 hidden px-4 py-3 rounded-xl bg-stone-900 text-white text-xs font-medium shadow-lg border border-stone-700 transition-all"
    ></div>

    <script>
      import { authClient } from '../lib/auth-client';

      document.getElementById('btn-logout')?.addEventListener('click', async () => {
        if (confirm('¿Deseas cerrar tu sesión?')) {
          await authClient.signOut();
          window.location.href = '/admin/login';
        }
      });
    </script>
  </body>
</html>
