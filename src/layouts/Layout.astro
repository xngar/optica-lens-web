---
import '../styles/global.css';
import { getDb, siteSettings } from '../db';
import type { Env } from '../types';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Óptica Visión Moderna | Armazones, Lentes Ópticos y De Sol',
  description = 'Catálogo exclusivo de lentes ópticos, de sol y filtro azul. Novedades semanales y asesoría especializada.',
} = Astro.props;

const env = Astro.locals.runtime?.env as Env;
let whatsappNumber = '+56912345678';
let opticalName = 'Óptica Visión Moderna';
let opticalAddress = 'Av. Providencia 1234, Providencia, Santiago';
let opticalHours = 'Lun a Vie: 09:30 - 19:30 | Sáb: 10:00 - 14:00';

if (env?.DB) {
  try {
    const db = getDb(env.DB);
    const settings = await db.select().from(siteSettings);
    settings.forEach((s) => {
      if (s.key === 'whatsapp_number') whatsappNumber = s.value;
      if (s.key === 'optical_name') opticalName = s.value;
      if (s.key === 'address') opticalAddress = s.value;
      if (s.key === 'business_hours') opticalHours = s.value;
    });
  } catch (e) {
    // Fallback a valores por defecto
  }
}

const cleanWhatsapp = whatsappNumber.replace(/[^0-9]/g, '');
const defaultWhatsappMsg = encodeURIComponent(`Hola ${opticalName}, me gustaría consultar sobre su catálogo de lentes.`);
const whatsappLink = `https://wa.me/${cleanWhatsapp}?text=${defaultWhatsappMsg}`;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen selection:bg-cyan-500 selection:text-white">
    <!-- Top banner de horarios -->
    <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Horario: {opticalHours}
          </span>
          <span class="hidden md:inline text-slate-600">•</span>
          <span class="hidden md:inline">📍 {opticalAddress}</span>
        </div>
        <div class="flex items-center gap-4">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="text-emerald-400 hover:text-emerald-300 font-medium flex items-center gap-1 transition"
          >
            <span>💬 WhatsApp Directo: {whatsappNumber}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Header Principal -->
    <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 border-b border-slate-200 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-cyan-600 to-blue-600 flex items-center justify-center text-white shadow-md shadow-cyan-600/20 group-hover:scale-105 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <div>
            <span class="text-xl font-extrabold tracking-tight text-slate-900 group-hover:text-cyan-600 transition block leading-tight">
              {opticalName}
            </span>
            <span class="text-xs text-slate-500 font-medium tracking-wide uppercase">Salud Visual & Estilo</span>
          </div>
        </a>

        <!-- Navegación -->
        <nav class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm font-semibold text-slate-600 hover:text-cyan-600 transition">Inicio</a>
          <a href="/catalogo" class="text-sm font-semibold text-slate-600 hover:text-cyan-600 transition">Catálogo de Lentes</a>
          <a href="/catalogo?weekly=true" class="text-sm font-semibold text-amber-600 hover:text-amber-700 flex items-center gap-1 transition">
            <span>✨ Novedades de la Semana</span>
          </a>
          <a href="/#contacto" class="text-sm font-semibold text-slate-600 hover:text-cyan-600 transition">Ubicación y Contacto</a>
        </nav>

        <!-- Botones de Acción -->
        <div class="flex items-center gap-3">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-sm transition"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
            </svg>
            <span>Consultar por WhatsApp</span>
          </a>

          {user ? (
            <a
              href="/admin"
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800 transition"
            >
              <span>Panel</span>
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            </a>
          ) : (
            <a
              href="/admin/login"
              class="inline-flex items-center gap-1 text-xs font-medium text-slate-500 hover:text-slate-800 px-2 py-1.5 rounded-lg hover:bg-slate-100 transition"
              title="Acceso Personal / Administrador"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span class="hidden sm:inline">Personal</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Botón flotante de WhatsApp en móviles/escritorio -->
    <aside class="fixed bottom-6 right-6 z-50">
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp"
        class="group flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white p-3.5 sm:px-5 sm:py-3.5 rounded-full shadow-lg shadow-emerald-500/30 hover:scale-105 transition-all duration-200"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
        </svg>
        <span class="hidden sm:inline font-bold text-sm tracking-wide">¿Tienes dudas? Escríbenos</span>
      </a>
    </aside>

    <!-- Footer -->
    <footer id="contacto" class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-10">
        <!-- Col 1: Sobre la óptica -->
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-cyan-600 flex items-center justify-center text-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <span class="text-xl font-bold text-white tracking-tight">{opticalName}</span>
          </div>
          <p class="text-slate-400 text-sm max-w-md leading-relaxed mb-6">
            Especialistas en salud visual, armazones de diseño y cristales de alta precisión. Actualizamos nuestro catálogo semanalmente con las últimas tendencias de moda y protección óptica.
          </p>
          <div class="flex items-center gap-3 text-sm text-slate-400">
            <span>🛡️ Calidad Garantizada</span>
            <span>•</span>
            <span>✨ Asesoría Personalizada</span>
          </div>
        </div>

        <!-- Col 2: Enlaces Rápidos -->
        <div>
          <h4 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Catálogo</h4>
          <ul class="space-y-2.5 text-sm">
            <li><a href="/catalogo?category=opticos" class="hover:text-cyan-400 transition">Lentes Ópticos</a></li>
            <li><a href="/catalogo?category=sol" class="hover:text-cyan-400 transition">Lentes de Sol</a></li>
            <li><a href="/catalogo?category=filtro-azul" class="hover:text-cyan-400 transition">Filtro de Luz Azul</a></li>
            <li><a href="/catalogo?category=infantil" class="hover:text-cyan-400 transition">Colección Infantil</a></li>
            <li><a href="/catalogo?weekly=true" class="text-amber-400 hover:underline transition">Novedades de la Semana</a></li>
          </ul>
        </div>

        <!-- Col 3: Contacto & Horarios -->
        <div>
          <h4 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Visítanos</h4>
          <ul class="space-y-3 text-sm text-slate-400">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400">📍</span>
              <span>{opticalAddress}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400">🕒</span>
              <span>{opticalHours}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-400">💬</span>
              <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-white transition">
                {whatsappNumber}
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-6 border-t border-slate-800 text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-4">
        <p>© {new Date().getFullYear()} {opticalName}. Todos los derechos reservados.</p>
        <div class="flex items-center gap-4">
          <a href="/admin/login" class="hover:text-slate-300 transition">Acceso al Panel de Control</a>
        </div>
      </div>
    </footer>
  </body>
</html>
