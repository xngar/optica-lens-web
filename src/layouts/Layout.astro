---
import '../styles/global.css';
import { getDb, siteSettings } from '../db';
import type { Env } from '../types';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Óptica Visión Moderna | Lentes Ópticos, de Sol y Filtro Azul',
  description = 'Lentes con diseño increíble y salud visual profesional. Nuevos modelos cada semana. Pruébatelos en tienda.',
} = Astro.props;

const env = Astro.locals.runtime?.env as Env;
let whatsappNumber = '+56912345678';
let opticalName = 'Óptica Visión Moderna';
let opticalAddress = 'Av. Providencia 1234, Providencia, Santiago';
let opticalHours = 'Lun a Vie: 09:30 - 19:30 | Sáb: 10:00 - 14:00';

if (env?.DB) {
  try {
    const db = getDb(env.DB);
    const settings = await db.select().from(siteSettings);
    settings.forEach((s) => {
      if (s.key === 'whatsapp_number') whatsappNumber = s.value;
      if (s.key === 'optical_name') opticalName = s.value;
      if (s.key === 'address') opticalAddress = s.value;
      if (s.key === 'business_hours') opticalHours = s.value;
    });
  } catch (e) {
    // Fallback a valores por defecto
  }
}

const cleanWhatsapp = whatsappNumber.replace(/[^0-9]/g, '');
const defaultWhatsappMsg = encodeURIComponent(`Hola ${opticalName}, quiero consultar por unos lentes que vi en la web.`);
const whatsappLink = `https://wa.me/${cleanWhatsapp}?text=${defaultWhatsappMsg}`;
const user = Astro.locals.user;

const currentPath = Astro.url.pathname;
const isWeeklyFilter = Astro.url.searchParams.get('weekly') === 'true';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-zinc-950 flex flex-col min-h-dvh selection:bg-blue-600 selection:text-white">
    <!-- Skip to main content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-blue-600 focus:text-white focus:rounded-xl focus:text-xs focus:font-bold focus:shadow-lg"
    >
      Saltar al contenido principal
    </a>

    <!-- Top Promo Bar estilo OPV / Ben & Frank -->
    <div class="bg-zinc-950 text-white text-xs py-2.5 px-4">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
        <div class="flex items-center gap-3">
          <span class="font-medium text-zinc-200 text-xs">
            Modelos nuevos todas las semanas · Pruébatelos gratis en tienda
          </span>
        </div>
        <div class="hidden md:flex items-center gap-4 text-xs text-zinc-300">
          <span class="inline-flex items-center gap-1.5">
            <svg class="size-3.5 text-blue-400 shrink-0" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{opticalHours}</span>
          </span>
          <span class="text-zinc-700" aria-hidden="true">|</span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="size-3.5 text-blue-400 shrink-0" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>{opticalAddress}</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Navbar Principal Moderno y Juvenil -->
    <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 border-b border-zinc-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a
          href="/"
          class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-xl"
        >
          <div class="size-11 rounded-2xl bg-blue-600 text-white flex items-center justify-center shadow-md shadow-blue-600/20 group-hover:rotate-[-4deg] group-hover:scale-105 transition-transform duration-200">
            <svg class="size-6" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6.5" cy="14" r="3.5" />
              <circle cx="17.5" cy="14" r="3.5" />
              <path d="M10 14h4" />
              <path d="M3 14V9a2 2 0 0 1 2-2h1" />
              <path d="M21 14V9a2 2 0 0 0-2-2h-1" />
            </svg>
          </div>
          <div>
            <span class="font-display text-xl sm:text-2xl font-extrabold tracking-tight text-zinc-950 block leading-none">
              {opticalName}
            </span>
            <span class="text-[11px] text-blue-600 font-bold tracking-wider uppercase block mt-0.5">
              Ver bien · Verte increíble
            </span>
          </div>
        </a>

        <!-- Navegación Desktop -->
        <nav class="hidden md:flex items-center gap-1.5" aria-label="Navegación principal">
          <a
            href="/"
            aria-current={currentPath === '/' ? 'page' : undefined}
            class={`px-4 py-2 rounded-full text-sm font-bold transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${
              currentPath === '/'
                ? 'bg-zinc-950 text-white'
                : 'text-zinc-700 hover:text-zinc-950 hover:bg-zinc-100'
            }`}
          >
            Inicio
          </a>
          <a
            href="/catalogo?category=opticos"
            class="px-4 py-2 rounded-full text-sm font-bold text-zinc-700 hover:text-zinc-950 hover:bg-zinc-100 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          >
            Ópticos
          </a>
          <a
            href="/catalogo?category=sol"
            class="px-4 py-2 rounded-full text-sm font-bold text-zinc-700 hover:text-zinc-950 hover:bg-zinc-100 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          >
            Lentes de Sol
          </a>
          <a
            href="/catalogo"
            aria-current={currentPath === '/catalogo' && !isWeeklyFilter ? 'page' : undefined}
            class={`px-4 py-2 rounded-full text-sm font-bold transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${
              currentPath === '/catalogo' && !isWeeklyFilter
                ? 'bg-zinc-950 text-white'
                : 'text-zinc-700 hover:text-zinc-950 hover:bg-zinc-100'
            }`}
          >
            Todo el Catálogo
          </a>
          <a
            href="/catalogo?weekly=true"
            aria-current={currentPath === '/catalogo' && isWeeklyFilter ? 'page' : undefined}
            class={`px-4 py-2 rounded-full text-sm font-extrabold inline-flex items-center gap-1.5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${
              currentPath === '/catalogo' && isWeeklyFilter
                ? 'bg-yellow-400 text-zinc-950 shadow-xs'
                : 'bg-yellow-300/80 hover:bg-yellow-400 text-zinc-950'
            }`}
          >
            <svg class="size-4 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
            <span>Novedades</span>
          </a>
        </nav>

        <!-- Acciones Derecha -->
        <div class="flex items-center gap-2.5">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 min-h-11 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-extrabold uppercase tracking-wider shadow-md shadow-emerald-500/20 hover:-translate-y-0.5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
          >
            <svg class="size-4 fill-current shrink-0" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
            </svg>
            <span>WhatsApp</span>
          </a>

          {user ? (
            <a
              href="/admin"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 min-h-10 rounded-full bg-zinc-950 text-white text-xs font-bold hover:bg-zinc-800 transition-colors"
            >
              <span>Panel</span>
              <span class="size-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
            </a>
          ) : (
            <a
              href="/admin/login"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-zinc-500 hover:text-zinc-950 px-3 py-2 min-h-10 rounded-full hover:bg-zinc-100 transition-colors"
              title="Acceso Equipo"
              aria-label="Acceso Equipo"
            >
              <svg class="size-4 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
              <span class="hidden lg:inline">Equipo</span>
            </a>
          )}

          <!-- Botón Menú Móvil -->
          <button
            type="button"
            id="mobile-menu-btn"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Abrir menú de navegación"
            class="md:hidden inline-flex items-center justify-center size-11 rounded-xl bg-zinc-100 text-zinc-900 hover:bg-zinc-200 transition-colors cursor-pointer"
          >
            <svg id="icon-menu-open" class="size-5" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <svg id="icon-menu-close" class="size-5 hidden" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Menú Móvil -->
      <nav
        id="mobile-menu"
        aria-label="Navegación móvil"
        class="hidden md:hidden border-t border-zinc-200 bg-white px-4 pt-3 pb-5 space-y-1.5 shadow-xl"
      >
        <a href="/" class="flex items-center justify-between px-4 py-3 min-h-11 rounded-xl text-sm font-bold text-zinc-900 hover:bg-zinc-100">
          <span>Inicio</span>
        </a>
        <a href="/catalogo?category=opticos" class="flex items-center justify-between px-4 py-3 min-h-11 rounded-xl text-sm font-bold text-zinc-900 hover:bg-zinc-100">
          <span>Lentes Ópticos</span>
        </a>
        <a href="/catalogo?category=sol" class="flex items-center justify-between px-4 py-3 min-h-11 rounded-xl text-sm font-bold text-zinc-900 hover:bg-zinc-100">
          <span>Lentes de Sol</span>
        </a>
        <a href="/catalogo" class="flex items-center justify-between px-4 py-3 min-h-11 rounded-xl text-sm font-bold text-zinc-900 hover:bg-zinc-100">
          <span>Todo el Catálogo</span>
        </a>
        <a href="/catalogo?weekly=true" class="flex items-center justify-between px-4 py-3 min-h-11 rounded-xl text-sm font-extrabold text-zinc-950 bg-yellow-300/80">
          <span class="inline-flex items-center gap-2">
            <svg class="size-4" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
            Novedades de la Semana
          </span>
        </a>
        <div class="pt-2">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 px-4 py-3 min-h-11 rounded-xl bg-emerald-500 text-white text-sm font-extrabold"
          >
            <span>Hablar por WhatsApp</span>
          </a>
        </div>
      </nav>
    </header>

    <!-- Contenido Principal -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Botón flotante de WhatsApp dinámico -->
    <aside class="fixed bottom-5 right-5 z-40">
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Hablar por WhatsApp"
        class="group flex items-center gap-2.5 bg-emerald-500 hover:bg-emerald-600 text-white p-3.5 sm:px-5 sm:py-3.5 min-h-12 min-w-12 rounded-full shadow-xl shadow-emerald-500/30 hover:scale-105 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
      >
        <svg class="size-6 fill-current shrink-0" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
        </svg>
        <span class="hidden sm:inline font-extrabold text-xs uppercase tracking-wider">¿Te ayudamos a elegir?</span>
      </a>
    </aside>

    <!-- Footer Moderno Estilo Ben & Frank / OPV -->
    <footer id="contacto" class="bg-zinc-950 text-zinc-400 pt-16 pb-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-12 gap-10">
        <!-- Col 1 -->
        <div class="md:col-span-5 space-y-4">
          <div class="flex items-center gap-3">
            <div class="size-10 rounded-xl bg-blue-600 flex items-center justify-center text-white">
              <svg class="size-5" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="6.5" cy="14" r="3.5" />
                <circle cx="17.5" cy="14" r="3.5" />
                <path d="M10 14h4" />
              </svg>
            </div>
            <span class="font-display text-xl font-extrabold text-white tracking-tight">{opticalName}</span>
          </div>
          <p class="text-zinc-400 text-sm max-w-sm leading-relaxed">
            Lentes con diseño increíble, cristales de alta precisión y precios justos. Subimos nuevos modelos todas las semanas para que vengas a probártelos sin compromiso.
          </p>
        </div>

        <!-- Col 2 -->
        <div class="md:col-span-3">
          <h4 class="font-display text-white text-sm font-extrabold uppercase tracking-wider mb-4">Categorías</h4>
          <ul class="space-y-2.5 text-sm font-medium">
            <li><a href="/catalogo?category=opticos" class="hover:text-white transition-colors">Lentes Ópticos</a></li>
            <li><a href="/catalogo?category=sol" class="hover:text-white transition-colors">Lentes de Sol</a></li>
            <li><a href="/catalogo?category=filtro-azul" class="hover:text-white transition-colors">Filtro Luz Azul</a></li>
            <li><a href="/catalogo?category=infantil" class="hover:text-white transition-colors">Línea Infantil</a></li>
            <li><a href="/catalogo?weekly=true" class="text-yellow-400 hover:text-yellow-300 font-bold transition-colors">Novedades de la Semana</a></li>
          </ul>
        </div>

        <!-- Col 3 -->
        <div class="md:col-span-4">
          <h4 class="font-display text-white text-sm font-extrabold uppercase tracking-wider mb-4">Ven a Probártelos</h4>
          <ul class="space-y-3 text-sm text-zinc-300">
            <li class="flex items-start gap-2.5">
              <svg class="size-4 text-blue-400 mt-0.5 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
              <span>{opticalAddress}</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="size-4 text-blue-400 mt-0.5 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{opticalHours}</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="size-4 text-emerald-400 mt-0.5 shrink-0" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
              </svg>
              <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-white font-bold transition-colors tabular-nums">
                WhatsApp: {whatsappNumber}
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-6 border-t border-zinc-900 text-xs text-zinc-500 flex flex-col sm:flex-row justify-between items-center gap-4">
        <p>© {new Date().getFullYear()} {opticalName}. Todos los derechos reservados.</p>
        <div class="flex items-center gap-4">
          <a href="/admin/login" class="hover:text-zinc-300 font-medium transition-colors">Acceso Equipo</a>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-menu-open');
      const iconClose = document.getElementById('icon-menu-close');

      menuBtn?.addEventListener('click', () => {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!isExpanded));
        mobileMenu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
